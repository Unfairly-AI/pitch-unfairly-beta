{
  "name": "my-astro-deck",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "story:check": "node bin/story-check.mjs",
    "build": "node bin/brand-apply.mjs && astro build",
    "pdf": "node bin/pdf.mjs",
    "preview": "astro preview",
    "setup:browser": "puppeteer browsers install",
    "audit": "node bin/audit.mjs",
    "shots": "node bin/shots.mjs",
    "manifest": "node bin/manifest.mjs",
    "upload": "node bin/upload.mjs",
    "source:pack": "node bin/source.mjs pack",
    "source:pull": "node bin/source.mjs pull",
    "review-files": "node bin/review-files.mjs",
    "motion": "node bin/motion.mjs",
    "brand:apply": "node bin/brand-apply.mjs",
    "brand:capture": "node bin/brand-capture.mjs",
    "brand:board": "node bin/brand-board.mjs",
    "site:check": "node bin/site-check.mjs",
    "site:census": "node bin/site-census.mjs",
    "site:map": "node bin/site-map.mjs",
    "site:build": "node bin/brand-apply.mjs && node bin/site-build.mjs",
    "site:audit": "node bin/brand-apply.mjs && node bin/site-audit.mjs",
    "site:manifest": "node bin/site-manifest.mjs",
    "test": "node --test 'test/*.test.mjs'"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "astro": "^7.3.2",
    "d3-geo": "^3.1.1",
    "puppeteer": "^25.11.0",
    "read-excel-file": "^9.3.12",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1"
  }
}
