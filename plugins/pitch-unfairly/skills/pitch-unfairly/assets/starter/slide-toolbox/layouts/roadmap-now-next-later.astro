---
/**
 * roadmap-now-next-later: the plan as horizons, without promising dates.
 *
 * The headline says what comes first and why. Below it one rule runs across
 * the slide in segments, one per horizon (now, next, later). The focal horizon
 * (by default the first) is wider, its segment is a heavy bar in the accent,
 * and its items are set in the display face; the later horizons are narrow and
 * quiet, a hairline over plain muted items. The label and the when of each
 * horizon sit on its segment in small caps. The segments draw in left to right.
 */
import Slide from '../../src/components/Slide.astro';
import { layoutRule, fitType, splitHl, type SlideBase } from '../lib';

interface Props extends SlideBase {
  /** What comes first and why, as a whole sentence. 12 words or fewer. */
  headline: string;
  /** One phrase of the headline, word for word, in the accent. The focal segment then goes to ink. */
  hl?: string;
  /** Two or three horizons, left to right, each a label of 12 characters or fewer ("Now"), an optional when ("Q1 2027") and 1 to 4 items of 48 characters or fewer. */
  lanes: { label: string; when?: string; items: string[] }[];
  /** Index of the horizon that carries the point. Default 0, the one under way. */
  focus?: number;
}

const { id, label = 'Roadmap', tone = 'warm', notes, brand, headline, hl, lanes, focus = 0 } = Astro.props;
const where = `roadmap-now-next-later "${id}"`;
if (lanes.length < 2 || lanes.length > 3) throw new Error(`${where}: two or three horizons (got ${lanes.length}); a fourth is a detail for the notes.`);
if (focus < 0 || focus >= lanes.length) throw new Error(`${where}: focus ${focus} isn't a horizon; use 0 to ${lanes.length - 1}.`);
for (const l of lanes) {
  if (l.label.length > 12) layoutRule(where, `${where}: horizon label "${l.label}" is over 12 characters ("Now", "Next", "Later").`);
  if (!l.items.length || l.items.length > 4) throw new Error(`${where}: horizon "${l.label}" has ${l.items.length} items; 1 to 4. The rest go in the notes.`);
  for (const it of l.items) if (it.length > 48) layoutRule(where, `${where}: "${it}" is ${it.length} characters; an item is 48 or fewer.`);
}
const heroItems = lanes[focus]!.items;
if (heroItems.length > 3) layoutRule(where, `${where}: the focal horizon "${lanes[focus]!.label}" has ${heroItems.length} items; it holds three at most, set large.`);
const [before, phrase, after] = splitHl(headline, hl, where);
// The focal horizon is wider: its items are set in the display face.
const cols = lanes.map((_, i) => (i === focus ? 'minmax(0, 7fr)' : 'minmax(0, 4fr)')).join(' ');
const longest = Math.max(...heroItems.map((s) => s.length));
const item = fitType(longest, { width: lanes.length === 3 ? 680 : 860, lines: 2, min: 44, max: 72 });
const head = fitType(headline.length, { width: 1500, lines: 2, min: 72, max: 112 });
const phone = fitType(headline.length, { width: 330, lines: 4, min: 28, max: 44 });
---

<Slide id={id} label={label} tone={tone} notes={notes} brand={brand}>
  <div class:list={['st-nnl', { 'has-hl': !!phrase }]} style={`--cols: ${cols}; --item: ${item}px; --head: ${head}px; --head-phone: ${phone}px`}>
    <h2 data-fit="2 4" class="display st-nnl-head rise">
      <slot name="headline">{before}{phrase && <span class="hl">{phrase}</span>}{after}</slot>
    </h2>
    <ol class="st-nnl-lanes" data-m="draw">
      {lanes.map((l, i) => (
        <li class:list={['st-nnl-lane', { 'is-focus': i === focus }]}>
          <span class="st-nnl-rule" aria-hidden="true" style={`--d: ${200 + i * 160}ms`}></span>
          <p class="st-nnl-when rise" style={`--d: ${280 + i * 160}ms`}>
            <b>{l.label}</b>
            {l.when && <span>{l.when}</span>}
          </p>
          <ul class="st-nnl-items">
            {l.items.map((it, k) => <li class="rise" style={`--d: ${380 + i * 160 + k * 70}ms`}>{it}</li>)}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</Slide>

<style>
  .st-nnl {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-rows: auto 1fr;
    row-gap: calc(var(--gap) * 1.5);
  }

  .st-nnl-head {
    max-width: 1500px;
    font-size: calc(var(--head) * var(--display-scale));
  }

  .st-nnl-lanes {
    display: grid;
    grid-template-columns: var(--cols);
    column-gap: 20px;
    align-self: end;
    align-items: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The rule: one line across the slide in segments, the focal one heavy and in the accent. */
  .st-nnl-rule {
    display: block;
    height: 2px;
    margin: 10px 0;
    background: color-mix(in oklab, currentColor 34%, transparent);
    transform-origin: left center;
  }

  .st-nnl-lane.is-focus .st-nnl-rule {
    height: 22px;
    margin: 0;
    border-radius: 11px;
    background: var(--hl-color);
  }

  .st-nnl.has-hl .st-nnl-lane.is-focus .st-nnl-rule { background: currentColor; }
  :global(.tone-accent) .st-nnl-lane.is-focus .st-nnl-rule { background: var(--on-accent); }

  .st-nnl-when {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    align-items: baseline;
    margin: 26px 0 0;
    font-family: var(--font-mono);
    font-size: var(--t-label);
    letter-spacing: var(--caps-tracking, 0.12em);
    text-transform: var(--label-case, uppercase);
  }

  .st-nnl-when b { font-weight: 700; }
  .st-nnl-when span { color: color-mix(in oklab, currentColor 66%, transparent); }

  .st-nnl-items {
    display: grid;
    gap: 22px;
    margin: calc(var(--gap) * 0.8) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--t-body);
    line-height: 1.25;
    color: color-mix(in oklab, currentColor 74%, transparent);
  }

  /* The focal horizon's items: the display face at the largest size that fits two lines. */
  .st-nnl-lane.is-focus .st-nnl-items {
    gap: 30px;
    padding-right: 40px;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: calc(var(--item) * var(--display-scale));
    letter-spacing: -0.025em;
    line-height: 1.04;
    color: var(--headline-color);
    text-wrap: balance;
  }

  :global(.tone-accent) .st-nnl-lane.is-focus .st-nnl-items { color: var(--on-accent); }
  :global(.tone-ink) .st-nnl-lane.is-focus .st-nnl-items { letter-spacing: -0.015em; }

  /* The showpiece: the segments draw in, now to later. */
  :global(.is-active) .st-nnl-rule { animation: st-nnl-draw var(--dur-draw) var(--ease) var(--d, 0ms) both; }

  @keyframes st-nnl-draw {
    from { transform: scaleX(0); }
    to { transform: none; }
  }

  /* Phone: the horizons stack in order, each under its own segment. The
     focal horizon keeps its heavy rule and display-face items. */
  @media (max-width: 799px) {
    .st-nnl {
      grid-template-rows: auto;
      align-content: start;
      row-gap: calc(var(--gap) * 1.6);
    }

    .st-nnl-head {
      max-width: none;
      font-size: calc(var(--head-phone) * var(--display-scale));
    }

    .st-nnl-lanes {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 28px;
    }

    .st-nnl-lanes { align-self: start; }
    .st-nnl-rule { margin: 4px 0; }
    .st-nnl-lane.is-focus .st-nnl-rule { height: 10px; margin: 0; }
    .st-nnl-when { margin-top: 12px; gap: 2px 12px; }
    .st-nnl-items { gap: 8px; margin-top: 10px; }

    .st-nnl-lane.is-focus .st-nnl-items {
      gap: 10px;
      padding-right: 0;
      font-size: calc(24px * var(--display-scale));
    }
  }

  /* PDF and every static render: every segment drawn, nothing waits on an entrance. */
  :global(html.is-static) .st-nnl .rise,
  :global(html.is-static) .st-nnl .st-nnl-rule {
    opacity: 1;
    transform: none;
    animation: none;
  }
</style>
