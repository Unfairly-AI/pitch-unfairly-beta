---
/**
 * problem-artifact: the pain as the real object it leaves behind.
 *
 * The headline and one line of context on the left; on the right, the thing
 * itself, set as type at its real proportions: a receipt, an email, a ticket
 * or a note (`kind`). The object is the slide's one focal element: it leans a
 * little (by the brand's --tilt), carries the focal shadow, and a slanted
 * stamp in the accent lands on its corner with the part that hurts ("4th this
 * week", "Reopened 3x"). A caption under the object adds one fact. The object
 * stays paper and ink on any tone: it is a thing, not a panel.
 *
 * What each kind reads:
 * - receipt: title (who issued it), fields (the line items), total.
 * - email:   title (the subject), fields (From, To, Sent), body.
 * - ticket:  title (the ticket's title), fields (its id, status, age), body.
 * - note:    body (what's written on it), title (who wrote it, when).
 */
import Slide from '../../src/components/Slide.astro';
import { fitType, splitHl, type SlideBase } from '../lib';

type Kind = 'receipt' | 'email' | 'ticket' | 'note';

interface Props extends SlideBase {
  /** The point, in a whole sentence. 14 words or fewer. */
  headline: string;
  /** One phrase of the headline, word for word, in the accent. The stamp then goes ink. */
  hl?: string;
  /** One line under the headline that adds a fact (how often, how many). 20 words or fewer. */
  context?: string;
  /** Which object: "receipt", "email", "ticket" or "note". */
  kind: Kind;
  /** The object's own heading: the receipt's issuer, the email's subject, the ticket's title, the note's signature. 60 characters or fewer. */
  title?: string;
  /** The object's labelled lines: receipt line items (up to 6), email headers (up to 4), ticket facts (up to 4). Not on a note. */
  fields?: { label: string; value: string }[];
  /** The object's text: the email or ticket body (280 characters or fewer), the note (120 or fewer). Not on a receipt. */
  body?: string;
  /** The receipt's total, set large at its foot. Receipt only. */
  total?: { label: string; value: string };
  /** The slanted stamp on the object's corner: the part that hurts. 18 characters or fewer. */
  stamp?: string;
  /** One quiet line under the object: a fact the object doesn't show. */
  caption?: string;
}

const { id, label = 'Problem', tone = 'paper', notes, brand, headline, hl, context, kind, title, fields = [], body, total, stamp, caption } = Astro.props;
const where = `problem-artifact "${id}"`;
const KINDS: Kind[] = ['receipt', 'email', 'ticket', 'note'];
if (!KINDS.includes(kind)) throw new Error(`${where}: kind "${kind}" isn't one of ${KINDS.join(', ')}.`);
const maxFields = { receipt: 6, email: 4, ticket: 4, note: 0 }[kind];
if (fields.length > maxFields) throw new Error(`${where}: a ${kind} takes ${maxFields ? `${maxFields} fields at most` : 'no fields'} (got ${fields.length}); ${maxFields ? 'the rest go in the notes' : 'put the words in body'}.`);
if (kind === 'receipt' && body) throw new Error(`${where}: a receipt has no body; its lines are fields and its foot is total.`);
if (kind !== 'receipt' && total) throw new Error(`${where}: total is a receipt's; on a ${kind}, the part that hurts goes in stamp.`);
if (kind === 'receipt' && !total) throw new Error(`${where}: a receipt needs its total ({ label, value }); that is the line the audience reads.`);
if (kind === 'note' && !body) throw new Error(`${where}: a note needs body, the words written on it.`);
if ((kind === 'email' || kind === 'ticket') && !title) throw new Error(`${where}: an ${kind} needs title (its ${kind === 'email' ? 'subject' : 'title'}).`);
const bodyMax = kind === 'note' ? 120 : 280;
if (body && body.length > bodyMax) throw new Error(`${where}: body is ${body.length} characters; a ${kind} on a slide reads at ${bodyMax} or fewer. Cut it to the lines that show the problem.`);
if (title && title.length > 60) throw new Error(`${where}: title is ${title.length} characters; 60 or fewer.`);
if (stamp && stamp.length > 18) throw new Error(`${where}: stamp "${stamp}" is ${stamp.length} characters; a stamp is a few words (18 or fewer).`);
const [before, phrase, after] = splitHl(headline, hl, where);
// The headline column is about 5/11 of the content width; three lines there, four on a phone.
const stage = fitType(headline.length, { width: 700, lines: 3, min: 64, max: 112 });
const phone = fitType(headline.length, { width: 330, lines: 4, min: 26, max: 42 });
const note = kind === 'note' ? fitType(body!.length, { width: 470, lines: 5, min: 40, max: 64, em: 0.5 }) : 0;
---

<Slide id={id} label={label} tone={tone} notes={notes} brand={brand}>
  <div class:list={['st-art', { 'has-hl': !!phrase }]} style={`--fit: ${stage}px; --fit-phone: ${phone}px; --note: ${note}px`}>
    <div class="st-art-text">
      <h2 data-fit="3 4" class="display st-art-head rise">
        <slot name="headline">{before}{phrase && <span class="hl">{phrase}</span>}{after}</slot>
      </h2>
      {context && <p class="st-art-context rise" style="--d: 120ms">{context}</p>}
    </div>
    <figure class="st-art-fig">
      <div class="st-art-hold rise" style="--d: 200ms">
      <div class:list={['st-art-obj', `is-${kind}`]}>
        {kind === 'receipt' && (
          <>
            {title && <p class="st-art-issuer">{title}</p>}
            <dl class="st-art-lines">
              {fields.map((f) => (
                <div>
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))}
            </dl>
            <p class="st-art-total"><span>{total!.label}</span><b>{total!.value}</b></p>
          </>
        )}
        {(kind === 'email' || kind === 'ticket') && (
          <>
            <p class="st-art-title">{title}</p>
            {fields.length > 0 && (
              <dl class="st-art-meta">
                {fields.map((f) => (
                  <div>
                    <dt>{f.label}</dt>
                    <dd>{f.value}</dd>
                  </div>
                ))}
              </dl>
            )}
            {body && <p class="st-art-body">{body}</p>}
          </>
        )}
        {kind === 'note' && (
          <>
            <p class="st-art-note">{body}</p>
            {title && <p class="st-art-sign">{title}</p>}
          </>
        )}
        {stamp && <span class="st-art-stamp pop" style="--d: 620ms; --r: -8deg">{stamp}</span>}
      </div>
      </div>
      {caption && <figcaption class="st-art-cap rise" style="--d: 420ms">{caption}</figcaption>}
    </figure>
  </div>
</Slide>

<style>
  .st-art {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    column-gap: calc(var(--gap) * 1.6);
    align-items: center;
  }

  .st-art-head {
    font-size: calc(var(--fit) * var(--display-scale));
    line-height: min(var(--display-line), 1);
  }

  .st-art-head .hl { white-space: nowrap; }

  .st-art-context {
    margin-top: calc(var(--gap) * 0.7);
    max-width: 640px;
    font-size: var(--t-lede);
    line-height: 1.3;
    color: color-mix(in oklab, currentColor 74%, transparent);
    text-wrap: pretty;
  }

  .st-art-fig {
    display: grid;
    justify-items: center;
    justify-self: stretch;
    gap: calc(var(--gap) * 0.75);
    min-width: 0;
  }

  .st-art-hold {
    width: 100%;
    display: grid;
    justify-items: center;
  }

  /* The focal element: a real-looking object, paper and ink on any tone, leaning by the brand's tilt. */
  .st-art-obj {
    position: relative;
    width: 100%;
    max-width: 820px;
    padding: 48px 56px;
    background: var(--paper);
    color: var(--ink);
    border: var(--border-w) solid var(--border-color);
    border-radius: min(var(--radius), 18px);
    box-shadow: var(--shadow-focal);
    transform: rotate(calc(-1.2deg * var(--tilt)));
  }

  /* receipt: narrow, mono, dotted lines, the total large at the foot. */
  .st-art-obj.is-receipt {
    max-width: 640px;
    padding: 60px 60px 50px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .st-art-issuer {
    padding-bottom: 28px;
    border-bottom: 2px dashed color-mix(in oklab, currentColor 40%, transparent);
    font-size: 24px;
    font-weight: 700;
    letter-spacing: var(--caps-tracking, 0.12em);
    text-transform: var(--label-case, uppercase);
    text-align: center;
  }

  .st-art-lines { margin: 18px 0 0; }

  .st-art-lines div {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 11px 0;
    font-size: 26px;
  }

  /* Dotted leaders between the item and its price. */
  .st-art-lines dt {
    flex: 1;
    display: flex;
    align-items: baseline;
    gap: 12px;
    min-width: 0;
  }

  .st-art-lines dt::after {
    content: '';
    flex: 1;
    min-width: 24px;
    border-bottom: 2px dotted color-mix(in oklab, currentColor 34%, transparent);
  }

  .st-art-lines dd { margin: 0; white-space: nowrap; }

  .st-art-total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    margin-top: 22px;
    padding-top: 22px;
    border-top: 2px dashed color-mix(in oklab, currentColor 40%, transparent);
  }

  .st-art-total span {
    font-size: var(--t-label);
    font-weight: 700;
    letter-spacing: var(--caps-tracking, 0.12em);
    text-transform: var(--label-case, uppercase);
  }

  .st-art-total b {
    font-family: var(--font-display);
    font-size: 96px;
    font-weight: var(--display-weight);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  /* email and ticket: a subject line, a ruled header, the body. */
  .st-art-title {
    font-family: var(--font-display);
    font-size: 46px;
    font-weight: var(--display-weight);
    letter-spacing: -0.02em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .st-art-meta {
    margin: 26px 0 0;
    padding: 14px 0;
    border-top: 1px solid color-mix(in oklab, currentColor 22%, transparent);
    border-bottom: 1px solid color-mix(in oklab, currentColor 22%, transparent);
  }

  .st-art-meta div {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 16px;
    align-items: baseline;
    padding: 5px 0;
  }

  .st-art-meta dt {
    font-family: var(--font-mono);
    font-size: var(--t-fine);
    font-weight: 600;
    letter-spacing: var(--caps-tracking, 0.12em);
    text-transform: var(--label-case, uppercase);
    color: color-mix(in oklab, currentColor 62%, transparent);
  }

  .st-art-meta dd {
    margin: 0;
    font-size: 26px;
  }

  .st-art-body {
    margin-top: 26px;
    font-size: var(--t-body);
    line-height: 1.45;
    text-wrap: pretty;
  }

  /* ticket: its facts as a row of chips-to-be, the first one (the id) in mono. */
  .is-ticket .st-art-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 36px;
    border-bottom: 0;
    padding-bottom: 0;
  }

  .is-ticket .st-art-meta div {
    display: grid;
    grid-template-columns: none;
    gap: 2px;
  }

  .is-ticket .st-art-meta dd { font-weight: 600; }
  .is-ticket .st-art-body { margin-top: 22px; }

  /* note: a sticky note in the kit's soft highlight, the words large. */
  .st-art-obj.is-note {
    max-width: 600px;
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 64px 60px 52px;
    background: var(--c-yellow-soft, var(--highlight));
    border: 0;
    border-radius: 4px;
    box-shadow: var(--shadow-card);
    transform: rotate(calc(2deg * var(--tilt)));
  }

  .st-art-note {
    font-family: var(--font-display);
    font-size: calc(var(--note) * var(--display-scale));
    font-weight: var(--display-weight);
    letter-spacing: -0.02em;
    line-height: 1.08;
  }

  .st-art-sign {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--caps-tracking, 0.12em);
    text-transform: var(--label-case, uppercase);
    color: color-mix(in oklab, currentColor 68%, transparent);
  }

  /* The stamp: the one accent on the slide, slanted across the object's corner. */
  .st-art-stamp {
    position: absolute;
    right: -36px;
    bottom: -40px;
    padding: 10px 24px 12px;
    border: 5px solid currentColor;
    border-radius: 10px;
    background: color-mix(in oklab, var(--paper) 90%, transparent);
    color: var(--accent-text, var(--accent-dark));
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: var(--display-weight);
    letter-spacing: 0.01em;
    line-height: 1;
    text-transform: var(--label-case, uppercase);
    white-space: nowrap;
    transform: rotate(calc(-8deg * var(--tilt)));
  }

  .st-art.has-hl .st-art-stamp { color: var(--ink); }

  .st-art-cap {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--caps-tracking, 0.12em);
    text-transform: var(--label-case, uppercase);
    text-align: center;
    color: color-mix(in oklab, currentColor 66%, transparent);
    margin-top: 30px;
  }

  :global(.tone-ink) .st-art-head { letter-spacing: calc(var(--display-tracking) * 0.85); }

  /* Phone: headline, then the object at the phone's width, then the caption.
     The context line goes; the object is the proof. */
  @media (max-width: 799px) {
    .st-art {
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      row-gap: calc(var(--gap) * 1.4);
    }

    .st-art-head { font-size: calc(var(--fit-phone) * var(--display-scale)); }
    .st-art-context { display: none; }
    .st-art-fig { gap: 16px; }

    .st-art-obj { padding: 20px 20px; transform: rotate(calc(-0.8deg * var(--tilt))); }
    .st-art-obj.is-receipt { max-width: 320px; padding: 22px 20px 18px; }
    .st-art-issuer { padding-bottom: 12px; font-size: 13px; }
    .st-art-lines { margin-top: 8px; }
    .st-art-lines div { padding: 4px 0; font-size: 13px; gap: 6px; }
    .st-art-lines dt { gap: 6px; }
    .st-art-lines dt::after { min-width: 8px; border-bottom-width: 1px; }
    .st-art-total { margin-top: 10px; padding-top: 10px; }
    .st-art-total span { font-size: 13px; }
    .st-art-total b { font-size: 34px; }

    .st-art-title { font-size: 20px; }
    .st-art-meta { margin-top: 12px; padding: 8px 0; }
    .st-art-meta div { grid-template-columns: 64px minmax(0, 1fr); gap: 8px; padding: 2px 0; }
    .st-art-meta dt { font-size: 13px; }
    .st-art-meta dd { font-size: 14px; }
    .is-ticket .st-art-meta { gap: 6px 20px; }
    .st-art-body { margin-top: 12px; font-size: 15px; }

    .st-art-obj.is-note { max-width: 280px; padding: 26px 24px 20px; }
    .st-art-note { font-size: calc(var(--note) * 0.46 * var(--display-scale)); }
    .st-art-sign { font-size: 13px; }

    .st-art-stamp {
      right: -6px;
      bottom: -22px;
      padding: 5px 12px 6px;
      border-width: 3px;
      border-radius: 6px;
      font-size: 22px;
    }

    .st-art-cap { margin-top: 18px; font-size: 13px; }
  }

  /* PDF and every static render: the object, the stamp and the caption all in place. */
  :global(html.is-static) .st-art .rise {
    opacity: 1;
    transform: none;
  }

  :global(html.is-static) .st-art .pop {
    opacity: 1;
    transform: rotate(calc(-8deg * var(--tilt)));
  }
</style>
