---
/**
 * section-number-title: the divider as the act's number at poster size.
 *
 * The number fills the lower left in the accent, as tall as the slide allows;
 * the act's title stands beside it on the number's foot, with one quiet line
 * under a hairline saying what the act answers. Along the top, a row of short
 * bars places this act among the rest. The space above the number is the
 * pause between acts.
 */
import Slide from '../../src/components/Slide.astro';
import { layoutRule, fitType, figureEm, type SlideBase } from '../lib';

interface Props extends SlideBase {
  /** The act's number as it should read: "02", "3". Three characters at most. */
  number: string;
  /** The act's name: six words or fewer. */
  title: string;
  /** One line under the title: what this act answers. 90 characters or fewer. */
  line?: string;
  /** How many acts the deck has (2 to 9). Draws the row of bars along the top, this one filled. */
  total?: number;
}

const { id, label = 'Section', tone = 'paper', notes, brand, number, title, line, total } = Astro.props;
const where = `section-number-title "${id}"`;
if (!/^\d{1,3}$/.test(number)) throw new Error(`${where}: number "${number}" should be one to three digits ("02"); the name goes in title.`);
if (title.split(/\s+/).length > 6) layoutRule(where, `${where}: the title is ${title.split(/\s+/).length} words; a section name is six or fewer. The rest goes in line.`);
if (line && line.length > 90) layoutRule(where, `${where}: line is ${line.length} characters; keep it to 90 or fewer.`);
const at = Number(number);
if (total !== undefined && (total < 2 || total > 9 || at < 1 || at > total)) throw new Error(`${where}: total ${total} with number ${number}: total is 2 to 9 and the number falls within it.`);
const em = figureEm(number);
// The number's height is the slide's; its width is what the title leaves.
const fig = Math.max(320, Math.min(680, Math.floor(820 / em)));
const figPhone = Math.max(120, Math.min(240, Math.floor(330 / em)));
const head = fitType(title.length, { width: 1648 - 84 - Math.round(fig * em), lines: 2, min: 84, max: 132 });
---

<Slide id={id} label={label} tone={tone} notes={notes} brand={brand}>
  <div class="st-secn" style={`--fig: ${fig}px; --fig-phone: ${figPhone}px; --head: ${head}px`}>
    {total && (
      <ol class="st-secn-bars rise" aria-hidden="true">
        {Array.from({ length: total }, (_, i) => <li class:list={{ 'is-past': i + 1 < at, 'is-now': i + 1 === at }} />)}
      </ol>
    )}
    <p class="display st-secn-n pop" style="--d: 60ms">{number}</p>
    <div class="st-secn-text">
      <h2 data-fit="2 4" class="display st-secn-title rise" style="--d: 200ms">{title}</h2>
      {line && <p class="st-secn-line rise" style="--d: 320ms">{line}</p>}
    </div>
  </div>
</Slide>

<style>
  .st-secn {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    column-gap: 84px;
    /* The number's tight line height leaves its font's descent hanging below
       the slide's foot; digits have no descenders, so clip it. */
    overflow: clip;
  }

  /* Where this act sits: one short bar per act, this one in the accent. */
  .st-secn-bars {
    grid-column: 1 / -1;
    display: flex;
    gap: 12px;
  }

  .st-secn-bars li {
    width: 72px;
    height: 8px;
    border-radius: 4px;
    background: color-mix(in oklab, currentColor 14%, transparent);
  }

  .st-secn-bars .is-past { background: color-mix(in oklab, currentColor 42%, transparent); }
  .st-secn-bars .is-now { background: var(--hl-color); }

  /* The focal element: the number, in the accent, standing on the slide's foot. */
  .st-secn-n {
    grid-row: 2;
    align-self: end;
    font-size: calc(var(--fig) * var(--display-scale));
    line-height: 0.74;
    letter-spacing: -0.05em;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--hl-color);
    margin: 0 0 -0.02em -0.04em;
  }

  .st-secn-text {
    grid-row: 2;
    align-self: end;
    max-width: 900px;
  }

  .st-secn-title {
    font-size: calc(var(--head) * var(--display-scale));
    line-height: min(var(--display-line), 1);
  }

  .st-secn-line {
    margin-top: calc(var(--gap) * 0.6);
    padding-top: calc(var(--gap) * 0.5);
    border-top: 1px solid color-mix(in oklab, currentColor 24%, transparent);
    font-size: var(--t-body);
    line-height: 1.35;
    color: color-mix(in oklab, currentColor 74%, transparent);
    max-width: 760px;
  }

  :global(.tone-accent) .st-secn-n { color: var(--on-accent); }
  :global(.tone-accent) .st-secn-bars .is-now { background: var(--on-accent); }

  /* Phone: the bars, then the number at the width the phone allows, then the
     title and its line under it. */
  @media (max-width: 799px) {
    .st-secn {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto 1fr auto;
      row-gap: calc(var(--gap) * 1.2);
    }

    .st-secn-bars { gap: 6px; }
    .st-secn-bars li { width: 32px; height: 5px; }
    .st-secn-n { font-size: calc(var(--fig-phone) * var(--display-scale)); }
    .st-secn-text { grid-row: 3; }
    .st-secn-title { font-size: var(--t-display); }
    .st-secn-line { margin-top: 12px; padding-top: 12px; }
  }

  /* PDF and every static render: the number and title rest in place. */
  :global(html.is-static) .st-secn .rise,
  :global(html.is-static) .st-secn .pop {
    opacity: 1;
    transform: none;
  }
</style>
