---
/**
 * statement-left-space: one sentence set in the right of the slide, with the
 * left left open.
 *
 * The sentence starts two fifths of the way across and runs left-aligned to
 * the edge, at the largest size that fits three lines, a little above center.
 * The open column to its left is the composition: it makes the line read as
 * considered, not centered by default. One quiet fact can anchor the foot of
 * that column. For a concession, a reframe, a line said slowly.
 */
import Slide from '../../src/components/Slide.astro';
import { layoutRule, fitType, splitHl, type SlideBase } from '../lib';

interface Props extends SlideBase {
  /** The sentence: one whole sentence, 24 words or fewer. */
  statement: string;
  /** One phrase of the statement, word for word, to set in the accent. */
  hl?: string;
  /** A quiet label above the statement: "Where we agree". Four words or fewer. */
  kicker?: string;
  /** One quiet fact at the foot of the open column, a label and its value: the source, the date, who said it. */
  aside?: { label: string; value: string };
}

const { id, label = 'Statement', tone = 'ink', notes, brand, statement, hl, kicker, aside } = Astro.props;
const where = `statement-left-space "${id}"`;
const words = statement.split(/\s+/).length;
if (words > 24) throw new Error(`${where}: the statement is ${words} words; keep it to 24 or fewer, or split it across two slides.`);
if (kicker && kicker.split(/\s+/).length > 4) layoutRule(where, `${where}: kicker "${kicker}" is a label of four words or fewer.`);
const [before, phrase, after] = splitHl(statement, hl, where);
// The sentence lands word by word (the motion kit's words) when it's 14 words or fewer.
const moving = words <= 14;
const stage = fitType(statement.length, { width: 950, lines: 3, min: 72, max: 124, em: 0.52 });
const phone = fitType(statement.length, { width: 330, lines: 4, min: 24, max: 44, em: 0.6 });
---

<Slide id={id} label={label} tone={tone} notes={notes} brand={brand}>
  <div class="st-left" style={`--fit: ${stage}px; --fit-phone: ${phone}px`}>
    <div class="st-left-text">
      {kicker && <p class="st-left-kicker rise">{kicker}</p>}
      <h2 data-fit="3 4" class:list={['display st-left-line', { rise: !moving }]} data-m={moving ? 'words' : undefined} style="--d: 100ms">
        <slot name="statement">{before}{phrase && <span class="hl">{phrase}</span>}{after}</slot>
      </h2>
    </div>
    {aside && (
      <dl class="st-left-aside rise" style="--d: 300ms">
        <dt>{aside.label}</dt>
        <dd>{aside.value}</dd>
      </dl>
    )}
  </div>
</Slide>

<style>
  .st-left {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: 2fr 3fr;
    grid-template-rows: 0.8fr auto 1fr auto;
    column-gap: var(--gap);
  }

  .st-left-text {
    grid-column: 2;
    grid-row: 2;
  }

  .st-left-kicker {
    margin-bottom: calc(var(--gap) * 0.7);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--caps-tracking, 0.12em);
    text-transform: var(--label-case, uppercase);
    color: color-mix(in oklab, currentColor 66%, transparent);
  }

  /* The focal element: the sentence, left-aligned in the right three fifths. */
  .st-left-line {
    font-size: calc(var(--fit) * var(--display-scale));
    line-height: max(var(--display-line), 1.04);
    text-wrap: pretty;
  }


  /* One quiet fact at the foot of the open column. */
  .st-left-aside {
    grid-column: 1;
    grid-row: 4;
    align-self: end;
    margin: 0;
    padding-top: 16px;
    border-top: 1px solid color-mix(in oklab, currentColor 24%, transparent);
    max-width: 420px;
  }

  .st-left-aside dt {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--caps-tracking, 0.12em);
    text-transform: var(--label-case, uppercase);
    color: color-mix(in oklab, currentColor 64%, transparent);
  }

  .st-left-aside dd {
    margin: 0.35em 0 0;
    font-size: var(--t-body);
    line-height: 1.35;
  }

  :global(.tone-ink) .st-left-line { letter-spacing: calc(var(--display-tracking) * 0.85); }

  /* Phone: no room for an open column. The sentence sits a third of the way
     down at the largest size that fits four lines; the fact sits at the foot. */
  @media (max-width: 799px) {
    .st-left {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 0.6fr auto 1fr auto;
    }

    .st-left-text { grid-column: 1; }
    .st-left-kicker { margin-bottom: 14px; }
    .st-left-line { font-size: calc(var(--fit-phone) * var(--display-scale)); }
    .st-left-aside { padding-top: 10px; max-width: none; }
  }

  /* PDF and every static render: nothing waits on an entrance. */
  :global(html.is-static) .st-left .rise {
    opacity: 1;
    transform: none;
  }
</style>
