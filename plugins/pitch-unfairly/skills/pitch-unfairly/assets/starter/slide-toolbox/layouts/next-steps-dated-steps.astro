---
/**
 * next-steps-dated-steps: what happens after this meeting, step by dated step.
 *
 * Left, the headline: where the steps lead, with its date. Right, the steps
 * down a line, each a date, the step and who owns it. The step that matters
 * most (by default the first, the one starting now) is the focal element: its
 * dot fills, its date takes the accent and the step is set in the display
 * face. The rest stay quiet. For proposals and meeting follow-ups; a sales
 * deck closes on the ask instead.
 */
import Slide from '../../src/components/Slide.astro';
import { fitType, splitHl, type SlideBase } from '../lib';

interface Props extends SlideBase {
  /** Where the steps lead, as a whole sentence, with its date. 12 words or fewer. */
  headline: string;
  /** One phrase of the headline, word for word, in the accent. The focal step then keeps its weight but goes to ink. */
  hl?: string;
  /** 2 to 5 steps in date order, each a short date of 12 characters or fewer ("Nov 24"), the step as a sentence of 56 or fewer, and who owns it. */
  steps: { date: string; step: string; owner?: string }[];
  /** Index of the step that matters most. Default 0, the one that starts now. */
  focus?: number;
}

const { id, label = 'Next steps', tone = 'ink', notes, brand, headline, hl, steps, focus = 0 } = Astro.props;
const where = `next-steps-dated-steps "${id}"`;
if (steps.length < 2 || steps.length > 5) throw new Error(`${where}: 2 to 5 steps (got ${steps.length}); fold the small ones together and put the detail in the notes.`);
if (focus < 0 || focus >= steps.length) throw new Error(`${where}: focus ${focus} isn't a step; use 0 to ${steps.length - 1}.`);
for (const s of steps) {
  if (s.date.length > 12) throw new Error(`${where}: date "${s.date}" is over 12 characters ("Nov 24", "Week of Dec 7").`);
  if (s.step.length > 56) throw new Error(`${where}: "${s.step}" is ${s.step.length} characters; a step is 56 or fewer.`);
}
const [before, phrase, after] = splitHl(headline, hl, where);
const head = fitType(headline.length, { width: 760, lines: 3, min: 72, max: 116 });
const phone = fitType(headline.length, { width: 330, lines: 4, min: 28, max: 44 });
---

<Slide id={id} label={label} tone={tone} notes={notes} brand={brand}>
  <div class:list={['st-steps', { 'has-hl': !!phrase }]} style={`--head: ${head}px; --head-phone: ${phone}px`}>
    <h2 data-fit="3 4" class="display st-steps-head rise">
      <slot name="headline">{before}{phrase && <span class="hl">{phrase}</span>}{after}</slot>
    </h2>
    <ol class="st-steps-list">
      {steps.map((s, i) => (
        <li class:list={['st-steps-row rise', { 'is-focus': i === focus }]} style={`--d: ${220 + i * 110}ms`}>
          <span class="st-steps-dot" aria-hidden="true"></span>
          <time class="st-steps-date">{s.date}</time>
          <span class="st-steps-step">{s.step}</span>
          {s.owner && <span class="st-steps-owner">{s.owner}</span>}
        </li>
      ))}
    </ol>
  </div>
</Slide>

<style>
  .st-steps {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: 760px minmax(0, 1fr);
    column-gap: calc(var(--gap) * 2);
    align-items: center;
  }

  .st-steps-head {
    font-size: calc(var(--head) * var(--display-scale));
  }

  :global(.tone-ink) .st-steps-head { letter-spacing: calc(var(--display-tracking) * 0.85); }

  /* The steps down one line: a dot on the line, the date, the step, its owner. */
  .st-steps-list {
    position: relative;
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .st-steps-list::before {
    content: '';
    position: absolute;
    top: 40px;
    bottom: 40px;
    left: 11px;
    border-left: 2px solid color-mix(in oklab, currentColor 26%, transparent);
  }

  .st-steps-row {
    position: relative;
    display: grid;
    grid-template-columns: 24px 150px minmax(0, 1fr);
    grid-template-areas: 'dot date step' '. . owner';
    column-gap: 32px;
    row-gap: 6px;
    align-items: baseline;
    padding: 26px 0;
  }

  .st-steps-dot {
    grid-area: dot;
    align-self: center;
    width: 24px;
    height: 24px;
    border: 2px solid color-mix(in oklab, currentColor 50%, transparent);
    border-radius: 50%;
    background: var(--night);
  }

  :global(.tone-paper) .st-steps-dot { background: var(--paper); }
  :global(.tone-warm) .st-steps-dot { background: var(--surface); }

  .st-steps-date {
    grid-area: date;
    font-family: var(--font-mono);
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--caps-tracking, 0.12em);
    text-transform: var(--label-case, uppercase);
    font-variant-numeric: tabular-nums;
    color: color-mix(in oklab, currentColor 70%, transparent);
  }

  .st-steps-step {
    grid-area: step;
    font-size: var(--t-body);
    line-height: 1.25;
    color: color-mix(in oklab, currentColor 80%, transparent);
  }

  .st-steps-owner {
    grid-area: owner;
    font-size: var(--t-label);
    color: color-mix(in oklab, currentColor 66%, transparent);
  }

  /* The focal step: a filled dot, the date in the accent, the step in the display face. */
  .st-steps-row.is-focus { padding: 40px 0; }

  .st-steps-row.is-focus .st-steps-dot {
    border-color: var(--hl-color);
    background: var(--hl-color);
    box-shadow: 0 0 0 8px color-mix(in oklab, var(--hl-color) 22%, transparent);
  }

  .st-steps-row.is-focus .st-steps-date { color: var(--hl-text, var(--hl-color)); }

  .st-steps-row.is-focus .st-steps-step {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: calc(46px * var(--display-scale));
    letter-spacing: -0.02em;
    line-height: 1.06;
    color: var(--headline-color);
    text-wrap: balance;
  }

  .st-steps.has-hl .st-steps-row.is-focus .st-steps-dot { border-color: currentColor; background: currentColor; box-shadow: none; }
  .st-steps.has-hl .st-steps-row.is-focus .st-steps-date { color: currentColor; }
  :global(.tone-accent) .st-steps-row.is-focus .st-steps-dot { border-color: var(--on-accent); background: var(--on-accent); box-shadow: none; }
  :global(.tone-accent) .st-steps-row.is-focus .st-steps-date { color: var(--on-accent); }
  :global(.tone-accent) .st-steps-dot { background: var(--accent); }

  /* Phone: the headline over the steps; each step stacks its date over its words. */
  @media (max-width: 799px) {
    .st-steps {
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      align-items: start;
      row-gap: calc(var(--gap) * 1.4);
    }

    .st-steps-head { font-size: calc(var(--head-phone) * var(--display-scale)); }

    .st-steps-list::before { top: 22px; bottom: 22px; left: 6px; }

    .st-steps-row,
    .st-steps-row.is-focus {
      grid-template-columns: 14px minmax(0, 1fr);
      grid-template-areas: 'dot date' '. step' '. owner';
      column-gap: 14px;
      row-gap: 3px;
      padding: 10px 0;
    }

    .st-steps-dot { width: 14px; height: 14px; }
    .st-steps-row.is-focus .st-steps-dot { box-shadow: 0 0 0 4px color-mix(in oklab, var(--hl-color) 22%, transparent); }
    .st-steps-row.is-focus .st-steps-step { font-size: calc(22px * var(--display-scale)); }
  }

  /* PDF and every static render: nothing waits on an entrance. */
  :global(html.is-static) .st-steps .rise {
    opacity: 1;
    transform: none;
  }
</style>
