---
/**
 * big-number-number-label: one figure at poster size, with what it measures.
 *
 * The headline across the top completes the figure's sentence. The figure
 * fills the lower left at the largest size its width allows, in the accent,
 * counting up as the slide enters, with a one-line caption saying exactly what
 * was measured. Up to three one-line supports sit in a quiet ledger to its
 * right, bottom-aligned with the caption. Without supports the figure takes
 * the whole width.
 */
import Slide from '../../src/components/Slide.astro';
import CountUp from '../../src/components/motion/CountUp.astro';
import { figureEm, fitType, unitScale, type SlideBase } from '../lib';

interface Props extends SlideBase {
  /** Completes the figure's sentence; does not repeat the figure. 10 words or fewer. */
  headline: string;
  /** The figure as written, digits only: "41", "4.2", "1,186". */
  number: string;
  /** Set before the figure, smaller and raised: "$", "£". */
  prefix?: string;
  /** Set after the figure: "%", "x", or a short word ("min", "hrs"). */
  unit?: string;
  /** What was measured, over what, when, in one line: "Average per crew, March to May 2026". */
  caption: string;
  /** Up to three one-line supports, each a label and its value. */
  supports?: { label: string; value: string }[];
  /** Count up to the figure as the slide enters. Default true when the figure is a plain number. */
  count?: boolean;
}

const { id, label = 'Big number', tone = 'paper', notes, brand, headline, number, prefix = '', unit = '', caption, supports = [], count } = Astro.props;
const where = `big-number-number-label "${id}"`;
if (supports.length > 3) throw new Error(`${where}: three supports at most (got ${supports.length}); the rest go in the notes.`);
if (!/\d/.test(number)) throw new Error(`${where}: number "${number}" has no digits; a word goes in the headline.`);
const plain = /^\d+(\.\d+)?$/.test(number);
const counts = (count ?? true) && plain;
const decimals = plain && number.includes('.') ? number.split('.')[1]!.length : 0;
const em = figureEm(number, prefix, unit);
// The figure's column on the stage: the content width, less the ledger when there is one.
const figureWidth = supports.length ? 1648 - 84 - 500 : 1648;
const stage = Math.max(240, Math.min(supports.length ? 560 : 640, Math.floor(figureWidth / em)));
const phone = Math.max(72, Math.min(210, Math.floor(330 / em)));
const head = fitType(headline.length, { width: 1500, lines: 2, min: 84, max: 124 });
---

<Slide id={id} label={label} tone={tone} notes={notes} brand={brand}>
  <div class:list={['st-big', { 'has-supports': supports.length > 0 }]} style={`--fig: ${stage}px; --fig-phone: ${phone}px; --head: ${head}px; --unit: ${unitScale(unit)}em`}>
    <h2 data-fit="2 4" class="display st-big-head rise">
      <slot name="headline">{headline}</slot>
    </h2>
    <figure class="st-big-fig">
      <p class="st-big-n display">
        {prefix && <span class="st-big-pre">{prefix}</span>}
        {counts ? <CountUp to={Number(number)} decimals={decimals} /> : <span>{number}</span>}
        {unit && <span class:list={['st-big-unit', { 'is-word': [...unit].length > 1 }]}>{unit}</span>}
      </p>
      <figcaption class="st-big-cap rise" style="--d: 420ms">{caption}</figcaption>
    </figure>
    {supports.length > 0 && (
      <dl class="st-big-ledger">
        {supports.map((s, i) => (
          <div class="rise" style={`--d: ${520 + i * 80}ms`}>
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))}
      </dl>
    )}
  </div>
</Slide>

<style>
  .st-big {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    column-gap: calc(var(--gap) * 1.5);
  }

  .st-big.has-supports { grid-template-columns: minmax(0, 1fr) 500px; }

  .st-big-head {
    grid-column: 1 / -1;
    max-width: 1500px;
    font-size: calc(var(--head) * var(--display-scale));
  }

  .st-big-fig {
    align-self: end;
    min-width: 0;
  }

  /* The focal element: the figure in the slide's one accent, at poster size. */
  .st-big-n {
    display: flex;
    align-items: baseline;
    font-size: calc(var(--fig) * var(--display-scale));
    line-height: 0.8;
    letter-spacing: -0.04em;
    font-variant-numeric: lining-nums tabular-nums;
    white-space: nowrap;
    color: var(--hl-color);
    /* Optical alignment: a figure's side bearing at this size would sit it right of the headline's edge. */
    margin-left: -0.02em;
  }

  .st-big-pre {
    align-self: flex-start;
    font-size: 0.5em;
    margin: 0.04em 0.04em 0 0;
  }

  .st-big-unit {
    font-size: var(--unit);
    margin-left: 0.02em;
  }

  .st-big-unit.is-word {
    margin-left: 0.12em;
    letter-spacing: -0.02em;
  }

  .st-big-cap {
    margin-top: calc(var(--gap) * 0.55);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--caps-tracking, 0.12em);
    text-transform: var(--label-case, uppercase);
    color: color-mix(in oklab, currentColor 66%, transparent);
  }

  /* Quiet support: hairline rows, label left, value right, on the caption's baseline. */
  .st-big-ledger {
    align-self: end;
    margin: 0;
    border-bottom: 1px solid color-mix(in oklab, currentColor 22%, transparent);
  }

  .st-big-ledger div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    padding: 22px 0;
    border-top: 1px solid color-mix(in oklab, currentColor 22%, transparent);
  }

  .st-big-ledger dt {
    font-size: var(--t-body);
    color: color-mix(in oklab, currentColor 72%, transparent);
  }

  .st-big-ledger dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--t-lede);
    font-weight: var(--display-weight);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* On an accent slide the accent is the background, so the figure takes the accent's text color. */
  :global(.tone-accent) .st-big-n { color: var(--on-accent); }

  /* Phone: one column, top to bottom. The figure stays the biggest thing on
     the screen: it is sized to the phone's width, not shrunk with the type. */
  @media (max-width: 799px) {
    .st-big,
    .st-big.has-supports {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto;
      align-content: start;
      row-gap: calc(var(--gap) * 1.6);
    }

    .st-big-head {
      max-width: none;
      font-size: var(--t-display);
    }

    .st-big-fig { align-self: start; }
    .st-big-n { font-size: calc(var(--fig-phone) * var(--display-scale)); }
    .st-big-cap { margin-top: 12px; }
    .st-big-ledger { align-self: start; }
    .st-big-ledger div { padding: 12px 0; }
  }

  /* PDF and every static render: CountUp already prints the final figure, and
     nothing waits on an entrance. */
  :global(html.is-static) .st-big .rise {
    opacity: 1;
    transform: none;
  }
</style>
