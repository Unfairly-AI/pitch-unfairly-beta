---
/**
 * statement-centered: one sentence, centered, at the largest size it fits.
 *
 * A quiet label above, the sentence in the middle of the slide at up to three
 * lines, and at most one line of fact under it. Nothing else. For the slide
 * the room should stop on: a goal, a turn in the argument, the one thing to
 * remember. The space around the sentence is the emphasis.
 */
import Slide from '../../src/components/Slide.astro';
import { fitType, splitHl, type SlideBase } from '../lib';

interface Props extends SlideBase {
  /** The sentence: one whole sentence, 20 words or fewer. */
  statement: string;
  /** One phrase of the statement, word for word, to set in the accent: often the number inside it. */
  hl?: string;
  /** A quiet label above the statement, when it needs one to be read right: "Our goal for 2027". Four words or fewer. */
  kicker?: string;
  /** One line under the statement that adds a fact (a date, a source, who it's for). 100 characters or fewer. */
  support?: string;
}

const { id, label = 'Statement', tone = 'warm', notes, brand, statement, hl, kicker, support } = Astro.props;
const where = `statement-centered "${id}"`;
const words = statement.split(/\s+/).length;
if (words > 20) throw new Error(`${where}: the statement is ${words} words; one big line is 20 or fewer. Cut it, or split it across two slides.`);
if (kicker && kicker.split(/\s+/).length > 4) throw new Error(`${where}: kicker "${kicker}" is a label of four words or fewer.`);
if (support && support.length > 100) throw new Error(`${where}: support is ${support.length} characters; one line is 100 or fewer. The rest goes in the notes.`);
const [before, phrase, after] = splitHl(statement, hl, where);
// The sentence lands word by word (the motion kit's words) when it's 14 words or fewer.
const moving = words <= 14;
const stage = fitType(statement.length, { width: 1480, lines: 3, min: 84, max: 148 });
const phone = fitType(statement.length, { width: 330, lines: 4, min: 24, max: 48, em: 0.6 });
---

<Slide id={id} label={label} tone={tone} notes={notes} brand={brand}>
  <div class="st-center" style={`--fit: ${stage}px; --fit-phone: ${phone}px`}>
    {kicker && <p class="st-center-kicker rise">{kicker}</p>}
    <h2 data-fit="3 4" class:list={['display st-center-line', { rise: !moving }]} data-m={moving ? 'words' : undefined} style="--d: 100ms">
      <slot name="statement">{before}{phrase && <span class="hl">{phrase}</span>}{after}</slot>
    </h2>
    {support && <p class="st-center-support rise" style="--d: 260ms">{support}</p>}
  </div>
</Slide>

<style>
  .st-center {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    /* Optical center: a touch above the middle. */
    padding-bottom: calc(var(--gap) * 0.8);
  }

  .st-center-kicker {
    margin-bottom: calc(var(--gap) * 0.9);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--caps-tracking, 0.12em);
    text-transform: var(--label-case, uppercase);
    color: color-mix(in oklab, currentColor 66%, transparent);
  }

  /* The focal element: the sentence, at the largest size that fits three lines. */
  .st-center-line {
    max-width: 1480px;
    font-size: calc(var(--fit) * var(--display-scale));
    line-height: max(var(--display-line), 1.02);
  }


  .st-center-support {
    margin-top: calc(var(--gap) * 1.1);
    max-width: 1000px;
    font-size: var(--t-lede);
    line-height: 1.3;
    text-wrap: balance;
    color: color-mix(in oklab, currentColor 72%, transparent);
  }

  :global(.tone-ink) .st-center-line { letter-spacing: calc(var(--display-tracking) * 0.85); }

  /* Phone: still centered; the sentence keeps the largest size that fits four lines. */
  @media (max-width: 799px) {
    .st-center { padding-bottom: 0; }
    .st-center-kicker { margin-bottom: 16px; }
    .st-center-line { font-size: calc(var(--fit-phone) * var(--display-scale)); }
    .st-center-support { margin-top: 18px; }
  }

  /* PDF and every static render: nothing waits on an entrance. */
  :global(html.is-static) .st-center .rise {
    opacity: 1;
    transform: none;
  }
</style>
