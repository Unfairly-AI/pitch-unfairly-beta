---
/**
 * objection-question-answer: the doubt in their words, then the answer at
 * poster size.
 *
 * The objection sits at the top in quotation marks, quiet and smaller, with
 * who raises it: it is the setup, not the point. A hairline, then the answer
 * fills the lower slide in the display face at the largest size that fits
 * three lines: it is the slide's headline and its focal element. One line of
 * proof under it, quiet, when the answer needs a fact behind it. Dark by
 * default: answering a doubt is a change of register.
 */
import Slide from '../../src/components/Slide.astro';
import { fitType, splitHl, type SlideBase } from '../lib';

interface Props extends SlideBase {
  /** The objection as the buyer would say it, without quotation marks, 120 characters or fewer. */
  question: string;
  /** Who raises it ("Harlow's CFO", "Every ops lead"), 40 characters or fewer. */
  asker?: string;
  /** The answer, one or two whole sentences, 90 characters or fewer. Set at the largest size that fits three lines. */
  answer: string;
  /** One phrase of the answer, word for word, in the accent. */
  hl?: string;
  /** One line of proof behind the answer: a number, a customer, a date. 110 characters or fewer. */
  proof?: string;
}

const { id, label = 'Objection', tone = 'ink', notes, brand, question, asker, answer, hl, proof } = Astro.props;
const where = `objection-question-answer "${id}"`;
if (/^["“'‘]|["”'’]$/.test(question.trim())) throw new Error(`${where}: leave the quotation marks off the question; the layout sets them.`);
if (question.length > 120) throw new Error(`${where}: the question is ${question.length} characters; 120 or fewer. Say it the way they would, short.`);
if (answer.length > 90) throw new Error(`${where}: the answer is ${answer.length} characters; 90 or fewer, so it reads at poster size. The detail goes in proof or the notes.`);
if (asker && asker.length > 40) throw new Error(`${where}: asker is ${asker.length} characters; 40 or fewer.`);
if (proof && proof.length > 110) throw new Error(`${where}: proof is ${proof.length} characters; 110 or fewer.`);
const [pre, phrase, post] = splitHl(answer, hl, where);
const stage = fitType(answer.length, { width: 1560, lines: 3, min: 88, max: 150 });
const phone = fitType(answer.length, { width: 330, lines: 4, min: 30, max: 50 });
---

<Slide id={id} label={label} tone={tone} notes={notes} brand={brand}>
  <div class="st-qa" style={`--fit: ${stage}px; --fit-phone: ${phone}px`}>
    <figure class="st-qa-q rise">
      <blockquote>
        <p><span class="st-qa-mark" aria-hidden="true">“</span>{question}<span aria-hidden="true">”</span></p>
      </blockquote>
      {asker && <figcaption>{asker}</figcaption>}
    </figure>
    <h2 data-fit="3 4" class="display st-qa-a rise" style="--d: 260ms">
      <slot name="answer">{pre}{phrase && <span class="hl">{phrase}</span>}{post}</slot>
    </h2>
    {proof && <p class="st-qa-proof rise" style="--d: 480ms">{proof}</p>}
  </div>
</Slide>

<style>
  .st-qa {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-rows: auto 1fr auto auto;
  }

  /* The setup: their words, quiet, hung on an outdented quotation mark. */
  .st-qa-q {
    max-width: 1240px;
    padding-bottom: calc(var(--gap) * 0.8);
    border-bottom: 1px solid color-mix(in oklab, currentColor 24%, transparent);
  }

  .st-qa-q p {
    font-size: calc(var(--t-lede) * 1.15);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: color-mix(in oklab, currentColor 76%, transparent);
    text-wrap: pretty;
  }

  .st-qa-mark {
    display: inline-block;
    width: 0.5em;
    margin-left: -0.5em;
  }

  .st-qa-q figcaption {
    margin-top: 18px;
    font-family: var(--font-mono);
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--caps-tracking, 0.12em);
    text-transform: var(--label-case, uppercase);
    color: color-mix(in oklab, currentColor 66%, transparent);
  }

  /* The focal element: the answer, as the slide's headline. */
  .st-qa-a {
    grid-row: 3;
    max-width: 1580px;
    font-size: calc(var(--fit) * var(--display-scale));
    line-height: min(var(--display-line), 1);
  }

  .st-qa-a .hl { white-space: nowrap; }

  .st-qa-proof {
    grid-row: 4;
    margin-top: calc(var(--gap) * 0.9);
    max-width: 1300px;
    font-size: var(--t-body);
    line-height: 1.35;
    color: color-mix(in oklab, currentColor 74%, transparent);
  }

  /* Light type on a dark slide needs a touch more room (craft rule 21). */
  :global(.tone-ink) .st-qa-a { letter-spacing: calc(var(--display-tracking) * 0.85); }

  /* Phone: the same order, top to bottom; the answer keeps the largest size
     that fits four lines. */
  @media (max-width: 799px) {
    .st-qa {
      grid-template-rows: auto;
      align-content: start;
    }

    .st-qa-q { max-width: none; padding-bottom: 18px; }
    .st-qa-q p { font-size: var(--t-lede); }
    .st-qa-mark { width: auto; margin-left: 0; }
    .st-qa-q figcaption { margin-top: 8px; }

    .st-qa-a {
      grid-row: auto;
      margin-top: calc(var(--gap) * 1.6);
      max-width: none;
      font-size: calc(var(--fit-phone) * var(--display-scale));
    }

    .st-qa-proof {
      grid-row: auto;
      margin-top: calc(var(--gap) * 1.1);
      font-size: var(--t-body);
    }
  }

  /* PDF and every static render: nothing waits on an entrance. */
  :global(html.is-static) .st-qa .rise {
    opacity: 1;
    transform: none;
  }
</style>
