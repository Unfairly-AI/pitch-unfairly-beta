---
/**
 * pricing-single-price: one price, set like a tag, with the terms beside it.
 *
 * The headline across the top says what they get for it. Lower left, the
 * price on the slide's one card: the figure at the largest size the card
 * allows, in the accent, what it's per under it, and a one-line caption under
 * a hairline. Lower right, up to five terms in a quiet ruled list, label over
 * value, bottom-aligned with the card. The price is the only heavy thing.
 */
import Slide from '../../src/components/Slide.astro';
import { figureEm, fitType, splitHl, type SlideBase } from '../lib';

interface Props extends SlideBase {
  /** What they get for the price, one whole sentence, 12 words or fewer. */
  headline: string;
  /** One phrase of the headline, word for word, in the accent. Then the price takes the ink. */
  hl?: string;
  /** The price as written, without the currency: "1,240", "18", "4.5k". */
  price: string;
  /** The currency, set smaller before the price: "$", "£", "€". */
  currency?: string;
  /** What the price is per, under it: "per crew, per month". 32 characters or fewer. */
  per?: string;
  /** One line on the card's foot: what's included or the term ("Billed yearly, cancel at renewal"). 48 characters or fewer. */
  caption?: string;
  /** Up to five terms beside the card, each a short label (24 or fewer) and its value (64 or fewer). */
  terms?: { label: string; value: string }[];
}

const { id, label = 'Pricing', tone = 'paper', notes, brand, headline, hl, price, currency = '', per, caption, terms = [] } = Astro.props;
const where = `pricing-single-price "${id}"`;
if (!/\d/.test(price)) throw new Error(`${where}: price "${price}" has no digits; a word ("Included") goes in the headline or a term.`);
if (price.length > 9) throw new Error(`${where}: price "${price}" is ${price.length} characters; 9 or fewer ("12,400", "4.5k").`);
if (per && per.length > 32) throw new Error(`${where}: per is ${per.length} characters; 32 or fewer.`);
if (caption && caption.length > 48) throw new Error(`${where}: caption is ${caption.length} characters; 48 or fewer.`);
if (terms.length > 5) throw new Error(`${where}: five terms at most (got ${terms.length}); the rest go in the notes.`);
for (const t of terms) {
  if (t.label.length > 24) throw new Error(`${where}: term label "${t.label}" is ${t.label.length} characters; 24 or fewer.`);
  if (t.value.length > 64) throw new Error(`${where}: term "${t.label}" value is ${t.value.length} characters; 64 or fewer.`);
}
const [pre, phrase, post] = splitHl(headline, hl, where);
const head = fitType(headline.length, { width: 1500, lines: 2, min: 76, max: 116 });
const em = figureEm(price, currency);
// The figure's room on the card: the card's width less its padding.
const cardWidth = terms.length ? 860 : 1100;
const fig = Math.max(160, Math.min(320, Math.floor((cardWidth - 120) / em)));
const figPhone = Math.max(64, Math.min(100, Math.floor(290 / em)));
---

<Slide id={id} label={label} tone={tone} notes={notes} brand={brand}>
  <div class:list={['st-price', { 'has-terms': terms.length > 0, 'has-hl': !!phrase }]} style={`--head: ${head}px; --fig: ${fig}px; --fig-phone: ${figPhone}px; --card: ${cardWidth}px`}>
    <h2 data-fit="2 4" class="display st-price-head rise">
      <slot name="headline">{pre}{phrase && <span class="hl">{phrase}</span>}{post}</slot>
    </h2>
    <figure class="st-price-tag card pop" style="--d: 220ms; --r: -2deg">
      <p class="st-price-n display">
        {currency && <span class="st-price-cur">{currency}</span>}
        <span>{price}</span>
      </p>
      {per && <p class="st-price-per">{per}</p>}
      {caption && <figcaption class="st-price-cap">{caption}</figcaption>}
    </figure>
    {terms.length > 0 && (
      <dl class="st-price-terms">
        {terms.map((t, i) => (
          <div class="rise" style={`--d: ${420 + i * 80}ms`}>
            <dt>{t.label}</dt>
            <dd>{t.value}</dd>
          </div>
        ))}
      </dl>
    )}
  </div>
</Slide>

<style>
  .st-price {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, var(--card));
    grid-template-rows: auto 1fr;
    column-gap: calc(var(--gap) * 1.5);
    align-items: end;
  }

  .st-price.has-terms { grid-template-columns: minmax(0, var(--card)) minmax(0, 1fr); }

  .st-price-head {
    grid-column: 1 / -1;
    align-self: start;
    max-width: 1500px;
    font-size: calc(var(--head) * var(--display-scale));
  }

  .st-price-head .hl { white-space: nowrap; }

  /* The focal element: the price on the slide's one card, leaning like a tag. */
  .st-price-tag {
    padding: 44px 60px 40px;
    box-shadow: var(--shadow-focal, var(--shadow-card));
    transform: rotate(calc(-2deg * var(--tilt)));
    transform-origin: 20% 80%;
  }

  .st-price-n {
    display: flex;
    align-items: baseline;
    font-size: calc(var(--fig) * var(--display-scale));
    line-height: 0.84;
    letter-spacing: -0.04em;
    font-variant-numeric: lining-nums tabular-nums;
    white-space: nowrap;
    color: var(--accent-text, var(--accent));
    margin-left: -0.03em;
  }

  .st-price.has-hl .st-price-n { color: var(--ink); }

  .st-price-cur {
    align-self: flex-start;
    font-size: 0.45em;
    margin: 0.06em 0.06em 0 0;
  }

  .st-price-per {
    margin-top: 22px;
    font-size: var(--t-lede);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .st-price-cap {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid color-mix(in oklab, currentColor 22%, transparent);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--caps-tracking, 0.12em);
    text-transform: var(--label-case, uppercase);
    color: color-mix(in oklab, currentColor 70%, transparent);
  }

  /* Quiet support: the terms, label over value, between hairlines. */
  .st-price-terms {
    margin: 0;
    border-bottom: 1px solid color-mix(in oklab, currentColor 22%, transparent);
  }

  .st-price-terms div {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
    gap: 24px;
    align-items: baseline;
    padding: 20px 0;
    border-top: 1px solid color-mix(in oklab, currentColor 22%, transparent);
  }

  .st-price-terms dt {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--caps-tracking, 0.12em);
    text-transform: var(--label-case, uppercase);
    color: color-mix(in oklab, currentColor 68%, transparent);
  }

  .st-price-terms dd {
    margin: 0;
    font-size: var(--t-body);
    line-height: 1.3;
  }

  /* Phone: one column, the tag above the terms; the price is sized to the phone's width. */
  @media (max-width: 799px) {
    .st-price,
    .st-price.has-terms {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto;
      align-content: start;
      row-gap: calc(var(--gap) * 1.2);
    }

    .st-price-head {
      max-width: none;
      font-size: var(--t-display);
    }

    .st-price-tag { padding: 22px 20px 18px; }
    .st-price-n { font-size: calc(var(--fig-phone) * var(--display-scale)); }
    .st-price-per { margin-top: 10px; font-size: var(--t-lede); }
    .st-price-cap { margin-top: 14px; padding-top: 10px; }
    .st-price-terms div { grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); gap: 12px; padding: 8px 0; }
  }

  /* PDF and every static render: the tag in place, the terms listed. */
  :global(html.is-static) .st-price .rise {
    opacity: 1;
    transform: none;
  }

  :global(html.is-static) .st-price .pop { opacity: 1; }
</style>
