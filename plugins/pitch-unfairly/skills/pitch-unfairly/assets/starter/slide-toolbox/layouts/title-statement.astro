---
/**
 * title-statement: the cover as one promise, set at poster size.
 *
 * The brand's mark at the top, the promise low on the page at the largest size
 * that fits three lines, and up to three facts along the foot (who it's for,
 * the date, the occasion) under a hairline. The space between the mark and the
 * promise is the design: it is what makes the promise read as a poster and not
 * a heading. For a brand that leads with type.
 */
import Slide from '../../src/components/Slide.astro';
import BrandMark from '../../src/components/BrandMark.astro';
import { fitType, markOn, splitHl, type SlideBase } from '../lib';

interface Props extends SlideBase {
  /** The promise: one whole sentence, 12 words or fewer. */
  headline: string;
  /** One phrase of the headline, word for word, to set in the accent. Most covers have none. */
  hl?: string;
  /** Up to three facts along the foot, each a short label and its value. */
  meta?: { label: string; value: string }[];
  /** Show the brand's mark at the top. Default true. */
  mark?: boolean;
}

const { id, label = 'Cover', tone = 'paper', notes, brand, headline, hl, meta = [], mark = true } = Astro.props;
const where = `title-statement "${id}"`;
if (meta.length > 3) throw new Error(`${where}: three meta facts at most (got ${meta.length}); the rest go in the notes.`);
const [before, phrase, after] = splitHl(headline, hl, where);
// Three lines across 1560px of the stage, four across a 330px phone.
const stage = fitType(headline.length, { width: 1560, lines: 3, min: 104, max: 176 });
const phone = fitType(headline.length, { width: 330, lines: 4, min: 30, max: 54 });
---

<Slide id={id} label={label} tone={tone} notes={notes} brand={brand} bare>
  <div class="st-title" style={`--fit: ${stage}px; --fit-phone: ${phone}px`}>
    {mark && <div class="st-title-mark rise"><BrandMark on={markOn(tone)} brand={brand} /></div>}
    <h1 data-fit="3 4" class="display st-title-line rise" style="--d: 90ms">
      <slot name="headline">{before}{phrase && <span class="hl">{phrase}</span>}{after}</slot>
    </h1>
    {meta.length > 0 && (
      <dl class="st-title-meta rise" style={`--d: 260ms; --n: ${meta.length}`}>
        {meta.map((m) => (
          <div>
            <dt>{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))}
      </dl>
    )}
  </div>
</Slide>

<style>
  .st-title {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-rows: auto 1fr auto auto;
  }

  .st-title-mark { grid-row: 1; }

  .st-title-line {
    grid-row: 3;
    max-width: 1560px;
    font-size: calc(var(--fit) * var(--display-scale));
    line-height: min(var(--display-line), 0.96);
  }

  .st-title-line .hl { white-space: nowrap; }

  /* The foot: a hairline, then the facts in even columns, label over value. */
  .st-title-meta {
    grid-row: 4;
    margin: calc(var(--gap) * 1.45) 0 0;
    padding-top: calc(var(--gap) * 0.5);
    border-top: 1px solid color-mix(in oklab, currentColor 24%, transparent);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
  }

  .st-title-meta dt {
    font-family: var(--font-mono);
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--caps-tracking, 0.12em);
    text-transform: var(--label-case, uppercase);
    color: color-mix(in oklab, currentColor 64%, transparent);
  }

  .st-title-meta dd {
    margin: 0.3em 0 0;
    font-size: var(--t-body);
    font-weight: 600;
  }

  /* Phone: the same order in one column. The promise keeps the largest size
     that fits four lines; the facts stack, label beside value. */
  @media (max-width: 799px) {
    .st-title-line {
      max-width: none;
      font-size: calc(var(--fit-phone) * var(--display-scale));
    }

    .st-title-meta {
      margin-top: calc(var(--gap) * 1.6);
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
      padding-top: 14px;
    }

    .st-title-meta div {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 16px;
    }

    .st-title-meta dd { margin: 0; text-align: right; }
  }

  /* PDF and every static render: nothing waits on an entrance. */
  :global(html.is-static) .st-title .rise {
    opacity: 1;
    transform: none;
  }
</style>
