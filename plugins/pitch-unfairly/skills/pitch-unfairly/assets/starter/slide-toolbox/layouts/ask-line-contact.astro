---
/**
 * ask-line-contact: the close as one request and the person to answer.
 *
 * The ask spans the upper slide at the largest size that fits three lines.
 * Under a hairline at the foot, the person who owns the next step: a photo or
 * monogram, their name and role, and the ways to reach them, set large enough
 * to copy from across the room and each a real link. For a deck that is sent
 * ahead or left behind, where the reader acts alone.
 */
import Slide from '../../src/components/Slide.astro';
import { layoutRule, fitType, initials, splitHl, type SlideBase } from '../lib';

interface Props extends SlideBase {
  /** The ask: one whole sentence, 12 words or fewer, saying what you want them to do. */
  headline: string;
  /** One phrase of the headline, word for word, to set in the accent. */
  hl?: string;
  /** Who to answer: their name, as they sign it. */
  name: string;
  /** Their title. */
  role?: string;
  /** A headshot URL (import it, or a path under public/). Without one, a monogram of the name. */
  photo?: string;
  /** Their email address. */
  email?: string;
  /** Their phone number, as it should be dialled: "+1 555 0142". */
  phone?: string;
  /** One more way in: a calendar or a page, its label (24 characters or fewer) and where it goes. */
  link?: { label: string; href: string };
}

const { id, label = 'Ask', tone = 'paper', notes, brand, headline, hl, name, role, photo, email, phone, link } = Astro.props;
const where = `ask-line-contact "${id}"`;
if (headline.split(/\s+/).length > 14) layoutRule(where, `${where}: the ask is ${headline.split(/\s+/).length} words; an ask is 12 or fewer. Cut it.`);
if (!email && !phone && !link) throw new Error(`${where}: give at least one way to reach ${name}: email, phone or link.`);
if (link && link.label.length > 24) layoutRule(where, `${where}: the link label is ${link.label.length} characters; keep it to 24 or fewer.`);
const [before, phrase, after] = splitHl(headline, hl, where);
const stage = fitType(headline.length, { width: 1560, lines: 3, min: 96, max: 156 });
const phonefit = fitType(headline.length, { width: 330, lines: 4, min: 30, max: 50 });
const ways = [
  email && { text: email, href: `mailto:${email}` },
  phone && { text: phone, href: `tel:${phone.replace(/[^\d+]/g, '')}` },
  link && { text: link.label, href: link.href },
].filter(Boolean) as { text: string; href: string }[];
---

<Slide id={id} label={label} tone={tone} notes={notes} brand={brand}>
  <div class="st-askc" style={`--fit: ${stage}px; --fit-phone: ${phonefit}px`}>
    <h2 data-fit="3 4" class="display st-askc-line rise">
      <slot name="headline">{before}{phrase && <span class="hl">{phrase}</span>}{after}</slot>
    </h2>
    <address class="st-askc-who">
      <span class="st-askc-person rise" style="--d: 260ms">
        {photo ? <img class="st-askc-face" src={photo} alt={name} /> : <span class="st-askc-face is-mono" aria-hidden="true">{initials(name)}</span>}
        <span class="st-askc-name">
          <b>{name}</b>
          {role && <span>{role}</span>}
        </span>
      </span>
      <ul class="st-askc-ways">
        {ways.map((w, i) => (
          <li class="rise" style={`--d: ${340 + i * 70}ms`}>
            <a href={w.href} target={/^https?:/.test(w.href) ? '_blank' : undefined} rel={/^https?:/.test(w.href) ? 'noopener' : undefined}>{w.text}</a>
          </li>
        ))}
      </ul>
    </address>
  </div>
</Slide>

<style>
  .st-askc {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-rows: 0.7fr auto 1fr auto;
  }

  /* The focal element: the ask. */
  .st-askc-line {
    grid-row: 2;
    max-width: 1560px;
    font-size: calc(var(--fit) * var(--display-scale));
    line-height: min(var(--display-line), 1);
  }


  /* The foot: who to answer, and how. */
  .st-askc-who {
    grid-row: 4;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: var(--gap);
    padding-top: calc(var(--gap) * 0.7);
    border-top: 1px solid color-mix(in oklab, currentColor 24%, transparent);
    font-style: normal;
  }

  .st-askc-person {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .st-askc-face {
    flex: none;
    width: 104px;
    height: 104px;
    border-radius: 50%;
    object-fit: cover;
  }

  .st-askc-face.is-mono {
    display: grid;
    place-items: center;
    background: color-mix(in oklab, currentColor 10%, transparent);
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 38px;
    letter-spacing: 0.02em;
  }

  .st-askc-name { display: grid; gap: 6px; }

  .st-askc-name b {
    font-size: var(--t-lede);
    font-weight: 700;
    line-height: 1.15;
  }

  .st-askc-name span {
    font-size: var(--t-label);
    color: color-mix(in oklab, currentColor 70%, transparent);
  }

  .st-askc-ways {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px 56px;
  }

  .st-askc-ways a {
    display: inline-flex;
    align-items: center;
    min-height: 56px;
    color: inherit;
    font-size: var(--t-lede);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, currentColor 30%, transparent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22em;
    transition: text-decoration-color var(--dur-hover) var(--ease-hover);
  }

  .st-askc-ways a:hover { text-decoration-color: var(--hl-color); }

  .st-askc-ways a:focus-visible {
    outline: 3px solid var(--hl-color);
    outline-offset: 6px;
    border-radius: 4px;
  }

  :global(.tone-accent) .st-askc-ways a:hover { text-decoration-color: currentColor; }
  :global(.tone-ink) .st-askc-line { letter-spacing: calc(var(--display-tracking) * 0.85); }

  /* Phone: the ask, then the person, then each way to reach them on its own
     line, each a full tap target. */
  @media (max-width: 799px) {
    .st-askc { grid-template-rows: 0.4fr auto 1fr auto; }
    .st-askc-line { max-width: none; font-size: calc(var(--fit-phone) * var(--display-scale)); }

    .st-askc-who {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 10px;
      padding-top: 16px;
    }

    .st-askc-person { gap: 14px; }
    .st-askc-face { width: 52px; height: 52px; }
    .st-askc-face.is-mono { font-size: 19px; }
    .st-askc-name { gap: 2px; }

    .st-askc-ways {
      flex-direction: column;
      justify-content: flex-start;
      gap: 0;
    }

    .st-askc-ways a {
      min-height: 44px;
      font-size: var(--t-body);
      overflow-wrap: anywhere;
    }
  }

  /* PDF and every static render: every way to reach them prints, and the
     links still work in the PDF. */
  :global(html.is-static) .st-askc .rise {
    opacity: 1;
    transform: none;
  }
</style>
