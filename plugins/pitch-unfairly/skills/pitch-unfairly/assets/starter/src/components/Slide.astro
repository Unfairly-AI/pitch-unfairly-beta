---
interface Props {
  /** Stable, unique id. Becomes #slide-{id}; audits and screenshots use it. */
  id: string;
  /** Short name for assistive tech and screenshots. */
  label: string;
  tone?: 'paper' | 'warm' | 'ink' | 'accent' | 'yellow' | 'cyan' | 'pink';
  /** Speaker notes. Press N while presenting. Put sources and caveats here. */
  notes?: string;
  /** Hide the page number, e.g. on a cover. */
  bare?: boolean;
  /** A sub-brand's id (brand/sub-brands/<id>.json): this slide wears that kit, the rest of the deck the main one. */
  brand?: string;
}

import { subBrands } from '../brand/sub-brands';

const { id, label, tone = 'paper', notes, bare = false, brand } = Astro.props;
if (brand && !subBrands[brand]) {
  throw new Error(`Slide "${id}": brand "${brand}" isn't a sub-brand. Add brand/sub-brands/${brand}.json (brand_kit_get with sub_brand) and run npm run brand:apply.${Object.keys(subBrands).length ? ` Sub-brands: ${Object.keys(subBrands).join(', ')}.` : ''}`);
}
---

<!-- The frame is one screen in the slide's color; the scaled slide sits inside it. -->
<div class={`deck-frame tone-${tone}`} data-brand={brand}>
  <section id={`slide-${id}`} class={`slide tone-${tone}`} aria-label={label} data-notes={notes}>
    <slot />
    {!bare && <span class="slide-num" aria-hidden="true"></span>}
  </section>
</div>
