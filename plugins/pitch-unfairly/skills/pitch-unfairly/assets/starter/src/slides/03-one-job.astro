---
import Slide from '../components/Slide.astro';
---

<Slide
  id="one-job"
  label="One job per slide"
  tone="ink"
  notes="Big-number slide. The number carries the point; the copy only explains what it counts."
>
  <div class="one-job">
    <p class="eyebrow rise">02 / The rule</p>
    <div class="row">
      <span class="number display pop" style="--d: 120ms">1</span>
      <div class="copy">
        <h2 class="display h-title rise" style="--d: 220ms">job per slide.</h2>
        <ul class="rise" style="--d: 300ms">
          <li><b>One headline</b> that states the point.</li>
          <li><b>One visual</b> that proves it.</li>
          <li><b>One thing</b> the audience remembers.</li>
        </ul>
      </div>
    </div>
  </div>
</Slide>

<style>
  .one-job {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .eyebrow { color: var(--accent); margin-bottom: 20px; }

  .row {
    display: flex;
    align-items: center;
    gap: 72px;
  }

  .number {
    font-size: 660px;
    line-height: 0.78;
    color: var(--accent);
    letter-spacing: -0.06em;
  }

  .h-title {
    font-size: var(--t-display);
    margin-bottom: 48px;
  }

  ul {
    display: grid;
    gap: 18px;
    font-size: var(--t-lede);
    line-height: 1.25;
    color: var(--on-night-a72);
  }

  li {
    padding-left: 44px;
    position: relative;
  }

  li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 22px;
    height: 4px;
    background: var(--accent);
  }

  li b { color: var(--on-night); font-weight: 650; }

  @media (max-width: 799px) {
    .row {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .number { font-size: 220px; }
    .h-title { margin-bottom: 22px; }
    ul { gap: 10px; }
    li { padding-left: 24px; }
    li::before { width: 12px; height: 2.5px; }
  }
</style>
