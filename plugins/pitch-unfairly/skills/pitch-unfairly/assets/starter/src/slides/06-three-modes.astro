---
import Slide from '../components/Slide.astro';

const modes = [
  { key: 'laptop', label: 'Present', size: '1920 × 1080, scaled' },
  { key: 'phone', label: 'Phone', size: '393 × 745' },
  { key: 'pdf', label: 'PDF', size: '1920 × 1080, 1:1' },
];
---

<Slide
  id="three-modes"
  label="Three modes"
  tone="ink"
  notes="Every change renders three ways. A fix in one mode does not fix the others."
>
  <div class="modes">
    <div class="head">
      <p class="eyebrow rise">05 / Done means</p>
      <h2 class="display h-title rise" style="--d: 80ms">One deck. <span class="hl">Three places</span> it has to work.</h2>
    </div>

    <div class="devices">
      {modes.map((m, i) => (
        <figure class={`device ${m.key} rise`} style={`--d: ${200 + i * 90}ms`}>
          <div class="screen" aria-hidden="true">
            <div class="mini"><b>Decks that land.</b><i></i></div>
          </div>
          <figcaption>
            <strong>{m.label}</strong>
            <span>{m.size}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</Slide>

<style>
  .modes {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .eyebrow { margin-bottom: 24px; color: var(--accent); }
  .h-title { max-width: 16ch; }

  .devices {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 64px;
  }

  .device { display: flex; flex-direction: column; gap: 26px; }
  .laptop { width: 44%; }
  .phone { width: 13%; }
  .pdf { width: 32%; }

  .screen {
    border: var(--border-w) solid var(--on-night);
    border-radius: 18px;
    overflow: hidden;
    background: var(--accent);
  }

  .laptop .screen { aspect-ratio: 16 / 10; border-width: 14px; border-color: var(--night-edge); }
  .phone .screen { aspect-ratio: 9 / 18.5; border-width: 10px; border-color: var(--night-edge); border-radius: 34px; }
  .pdf .screen { aspect-ratio: 16 / 9; border-radius: 4px; border-width: 0; box-shadow: var(--shadow-contrast); }

  .mini {
    container-type: inline-size;
    height: 100%;
    padding: 9%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6cqi;
  }

  .mini b {
    font: 750 13cqi/0.95 var(--font-display);
    letter-spacing: -0.045em;
    color: var(--ink);
  }

  .phone .mini b { font-size: 22cqi; }

  .mini i {
    display: block;
    width: 55%;
    height: 3cqi;
    border-radius: 2cqi;
    background: var(--ink);
    opacity: 0.6;
  }

  figcaption {
    display: grid;
    gap: 4px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  figcaption strong { font-size: var(--t-label); color: var(--on-night); }
  figcaption span { font-size: var(--t-fine); color: var(--on-night-a55); }

  @media (max-width: 799px) {
    .modes { justify-content: center; gap: 40px; }
    .eyebrow { margin-bottom: 12px; }
    .devices { gap: 14px; }
    .laptop { width: 44%; }
    .phone { width: 16%; }
    .pdf { width: 34%; }
    .device { gap: 10px; }
    .laptop .screen { border-width: 5px; border-radius: 8px; }
    .phone .screen { border-width: 4px; border-radius: 12px; }
    .pdf .screen { box-shadow: var(--shadow-contrast); }
    figcaption span { display: none; }
  }
</style>
