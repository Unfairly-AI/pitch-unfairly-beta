---
// Pattern: mockup. A faithful HTML mockup of the product inside window chrome,
// tilted a degree with the slide's only hard shadow. The claim sits beside it,
// never on top of it. Use a real screenshot when you have one.
import Slide from '../components/Slide.astro';

const link = 'pitchunfairly.com/fizz/launch';
---

<Slide
  id="chat"
  label="From a chat to a link"
  tone="warm"
  notes="One prompt in, one link out. The story comes first, then the brand, then every slide is checked. Fizz Soda is a made-up company."
>
  <div class="chat">
    <div class="copy">
      <h2 class="display h-display rise">Describe it in a chat. <span class="hl">Send a link.</span></h2>
      <p class="lede rise" style="--d: 120ms">Your story, your brand, every screen. No templates.</p>
    </div>

    <figure class="window rise" style="--d: 220ms" aria-label="A chat that ends with a deck link">
      <div class="bar"><i></i><i></i><i></i><span>New chat</span></div>
      <div class="thread">
        <p class="me">Make a launch deck for Fizz Soda in our brand, from fizzsoda.com. Six slides.</p>
        <div class="reply">
          <p>Story's ready: six slides, one job each. Here's your deck.</p>
          <a class="unfurl pop" style="--d: 760ms" href="#slide-cover">
            <span class="thumb"><span>The soda your gut <em>actually</em> likes.</span></span>
            <span class="meta"><b>Fizz Soda: Launch</b><small>{link}</small></span>
          </a>
        </div>
      </div>
    </figure>
  </div>
</Slide>

<style>
  .chat {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: center;
    gap: calc(var(--gap) * 1.4);
  }

  .h-display { margin-bottom: 36px; }
  .lede { max-width: 22ch; }

  .window {
    margin: 0;
    overflow: hidden;
    border: var(--border-w) solid var(--border-color);
    border-radius: var(--radius);
    background: var(--paper);
    box-shadow: var(--shadow-card);
    transform: rotate(calc(1.2deg * var(--tilt)));
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 22px;
    border-bottom: var(--border-w) solid var(--border-color);
    font: 600 var(--t-label)/1 var(--font-mono);
  }
  .bar i { width: 16px; height: 16px; border: 3px solid var(--border-color); border-radius: 50%; }
  .bar span { margin-left: 12px; color: var(--ink-muted); }

  .thread { display: grid; gap: 26px; padding: 34px 40px 38px; }

  .me {
    justify-self: end;
    max-width: 30ch;
    margin: 0;
    padding: 22px 28px;
    border-radius: 28px 28px 8px 28px;
    background: var(--accent);
    color: var(--on-accent);
    font: 500 30px/1.35 var(--font-body);
  }

  .reply { display: grid; gap: 22px; max-width: 34ch; }
  .reply > p { margin: 0; font: 450 30px/1.35 var(--font-body); }

  /* The deck's link, unfurled the way a chat app shows it. */
  .unfurl {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: min(100%, 460px);
    gap: 14px;
    padding: 12px 12px 16px;
    border: 3px solid var(--border-color);
    border-radius: 22px;
    background: var(--surface);
    color: inherit;
    text-decoration: none;
  }

  .thumb {
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: flex-end;
    padding: 28px;
    border-radius: 12px;
    background: var(--c-cyan, var(--accent-2));
  }
  .thumb span { max-width: 12ch; font: 800 44px/0.98 var(--font-display); letter-spacing: -0.04em; color: var(--ink); }
  .thumb em { font-style: normal; color: var(--accent); }

  .meta { display: grid; gap: 8px; min-width: 0; padding: 0 6px; }
  .meta b { font: 700 28px/1.15 var(--font-display); letter-spacing: -0.02em; }
  .meta small { overflow: hidden; font: 500 var(--t-label)/1 var(--font-mono); color: var(--ink-muted); text-overflow: ellipsis; white-space: nowrap; }

  @media (max-width: 799px) {
    .chat { grid-template-columns: 1fr; align-content: center; gap: 26px; }
    .h-display { margin-bottom: 12px; }
    .window { transform: none; }
    .bar { padding: 10px 14px; }
    .bar i { width: 10px; height: 10px; border-width: 2px; }
    .thread { gap: 14px; padding: 18px; }
    .me { padding: 12px 16px; border-radius: 18px 18px 6px 18px; font-size: 15px; }
    .reply { gap: 12px; }
    .reply > p { font-size: 15px; }
    .unfurl { gap: 8px; padding: 8px 8px 10px; border-width: 2px; border-radius: 14px; }
    .thumb { padding: 12px; }
    .thumb span { font-size: 20px; }
    .meta b { font-size: 15px; }
  }
</style>
