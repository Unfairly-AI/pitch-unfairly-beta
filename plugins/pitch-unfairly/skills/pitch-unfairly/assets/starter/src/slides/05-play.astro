---
// Pattern: interactive. A deck is a website, so a slide can hold a real input.
// One slider drives one number. The resting markup shows the starting value,
// so the PDF and no-JS still show a real figure. Label made-up numbers.
import Slide from '../components/Slide.astro';

// Example model: each rep saves 3 hours a week at $60 an hour, over 46 weeks.
const perRep = 3 * 60 * 46;
const start = 12;
const max = 40;
const money = (v: number) => `$${Math.round(v / 1000)}k`;
---

<Slide
  id="play"
  label="Interactive"
  tone="pink"
  notes={`Go on, drag it. This is a normal slide with a normal input on it, because the deck is a website. A buyer can try the ROI with their own team size. The numbers are examples: each rep saves 3 hours a week at $60 an hour, over 46 working weeks. Yours come from your model.`}
>
  <div class="play">
    <div class="copy">
      <h2 class="display h-display rise">Let them <span class="hl">play with your numbers.</span></h2>
      <p class="lede rise" style="--d: 120ms">If a browser can do it, your deck can.</p>
    </div>

    <div class="toy rise" style="--d: 240ms" data-toy data-per={perRep} data-max={max}>
      <div class="model">
        <span class="chip">Example</span>
        <p class="model-head">A team of <b data-n>{start}</b> <span data-reps>reps</span> saves</p>
        <p class="big"><span data-value>{money(start * perRep)}</span> <span class="unit">a year</span></p>
      </div>
      <input type="range" min="1" max={max} step="1" value={start} aria-label="Reps on the team" />
    </div>
  </div>
</Slide>

<script>
  // Team size times hours saved: the number follows the slider.
  for (const toy of document.querySelectorAll<HTMLElement>('[data-toy]')) {
    const input = toy.querySelector('input')!;
    const per = Number(toy.dataset.per);
    const max = Number(toy.dataset.max);
    const set = () => {
      const n = Number(input.value);
      toy.style.setProperty('--u', String((n - 1) / (max - 1)));
      toy.querySelector('[data-n]')!.textContent = String(n);
      toy.querySelector('[data-reps]')!.textContent = n === 1 ? 'rep' : 'reps';
      toy.querySelector('[data-value]')!.textContent = `$${Math.round((n * per) / 1000)}k`;
    };
    input.addEventListener('input', set);
    // Arrow keys move the slider, not the deck.
    input.addEventListener('keydown', (e) => e.stopPropagation());
    set();
  }
</script>

<style>
  .play {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: calc(var(--gap) * 1.6);
  }

  .h-display { margin-bottom: 36px; }
  .lede { max-width: 20ch; }

  .toy { --u: 0.28; --pct: calc(var(--u) * 100%); min-width: 0; display: grid; gap: 72px; }

  /* The one card: the model the slider drives. */
  .model {
    position: relative;
    padding: 56px 60px 60px;
    border: var(--border-w) solid var(--border-color);
    border-radius: var(--radius);
    background: var(--paper);
    box-shadow: var(--shadow-card);
    transform: rotate(calc(-1.5deg * var(--tilt)));
  }

  /* A sticker on the card's edge, so it never sits on the numbers. */
  .chip {
    position: absolute;
    top: -24px;
    right: 48px;
    padding: 10px 18px;
    border: 3px solid var(--border-color);
    border-radius: 99px;
    background: var(--c-yellow, var(--highlight));
    transform: rotate(calc(3deg * var(--tilt)));
    font: 700 var(--t-label)/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .model-head { margin: 0; font: 750 52px/1.05 var(--font-display); letter-spacing: -0.035em; }
  .model-head b { color: var(--accent); font-variant-numeric: tabular-nums; }

  .big { margin: 20px 0 0; font: 800 200px/0.9 var(--font-display); letter-spacing: -0.055em; font-variant-numeric: tabular-nums; color: var(--accent); white-space: nowrap; }
  .unit { display: block; margin-top: 14px; font-size: 52px; letter-spacing: -0.035em; color: var(--ink); }

  input[type='range'] {
    appearance: none;
    width: 100%;
    height: 28px;
    margin: 0;
    border: var(--border-w) solid var(--border-color);
    border-radius: 999px;
    background: linear-gradient(90deg, var(--accent) var(--pct), var(--paper) var(--pct));
    cursor: pointer;
  }
  input[type='range']::-webkit-slider-thumb { appearance: none; width: 64px; height: 64px; border: 5px solid var(--border-color); border-radius: 50%; background: var(--paper); box-shadow: 0 6px 0 var(--border-color); }
  input[type='range']::-moz-range-thumb { width: 54px; height: 54px; border: 5px solid var(--border-color); border-radius: 50%; background: var(--paper); box-shadow: 0 6px 0 var(--border-color); }
  input[type='range']:focus-visible { outline: 4px solid var(--accent-2); outline-offset: 6px; }

  @media (max-width: 799px) {
    .play { grid-template-columns: minmax(0, 1fr); align-content: center; gap: 34px; }
    .h-display { margin-bottom: 12px; }
    .toy { gap: 32px; }
    .model { padding: 26px 22px; }
    .chip { top: -14px; right: 20px; padding: 4px 8px; border-width: 2px; letter-spacing: 0.04em; }
    .model-head { font-size: 20px; }
    .big { margin-top: 10px; font-size: 76px; }
    .unit { margin-top: 6px; font-size: 20px; }
    input[type='range'] { height: 20px; }
    input[type='range']::-webkit-slider-thumb { width: 44px; height: 44px; border-width: 4px; box-shadow: 0 4px 0 var(--border-color); }
  }
</style>
