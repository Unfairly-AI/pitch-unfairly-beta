---
import Slide from '../components/Slide.astro';
import BrandMark from '../components/BrandMark.astro';
import { imagery } from '../brand/assets';

// Photographic brands open on their own imagery; others get the card fan.
const hero = imagery.find((img) => img.role === 'hero');
const illustration = !hero && imagery.find((img) => img.role === 'illustration');
---

<Slide id="cover" label="Cover" tone="accent" bare notes="Open on the promise. Say the line, pause, then move on.">
  {hero && <img class="photo" src={hero.url} alt="" data-bleed />}
  <div class:list={['cover', { 'has-photo': hero }]}>
    <div class="copy">
      <BrandMark on={hero ? 'ink' : 'accent'} height={52} class="rise mark" />
      <h1 class="display hero rise" style="--d: 80ms">Decks that <span class="hl">land.</span></h1>
      <p class="lede rise" style="--d: 160ms">
        Every slide designed for its job, then checked on a laptop, a phone, and a PDF.
      </p>
    </div>

    {illustration && <img class="art pop" src={illustration.url} alt="" style="--d: 260ms" />}
    {!hero && !illustration && <div class="fan" aria-hidden="true">
      <div class="mini card pop" style="--r: -8deg; --d: 260ms">
        <i class="bar wide"></i><i class="bar"></i><i class="dot"></i>
      </div>
      <div class="mini card pop" style="--r: 5deg; --d: 340ms">
        <b>1</b><i class="bar"></i>
      </div>
      <div class="mini card pop focus" style="--r: -2deg; --d: 420ms">
        <i class="bar wide"></i><i class="bar wide"></i><i class="bar"></i>
      </div>
    </div>}
  </div>
</Slide>

<style>
  .cover {
    flex: 1;
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    align-items: center;
    gap: var(--gap);
  }

  .mark { margin-bottom: 56px; }

  .art { width: 100%; max-height: 760px; object-fit: contain; }

  /* Photo cover: full bleed with a scrim so the headline always reads. */
  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .has-photo { position: relative; color: var(--paper); }
  .has-photo .display { color: var(--paper); }
  .has-photo .hl { color: var(--paper); opacity: 0.82; }
  .has-photo .lede { color: var(--paper-a72); }
  :global(.slide):has(.has-photo)::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, color-mix(in oklab, var(--ink) 72%, transparent) 0%, color-mix(in oklab, var(--ink) 20%, transparent) 70%, transparent 100%);
  }
  .has-photo { z-index: 1; }
  .hero { margin-bottom: 44px; }
  .lede { max-width: 22ch; }

  .fan {
    position: relative;
    height: 620px;
  }

  .mini {
    position: absolute;
    width: 480px;
    aspect-ratio: 16 / 9;
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 16px;
    transform: rotate(calc(var(--r) * var(--tilt)));
  }

  .mini:nth-child(1) { top: 0; left: 40px; }
  .mini:nth-child(2) { top: 170px; left: 180px; background: var(--ink); }
  .mini:nth-child(3) { top: 340px; left: 20px; }

  .mini.focus { box-shadow: var(--shadow-card), 0 0 0 10px var(--paper-a35); }

  .bar {
    display: block;
    height: 22px;
    width: 45%;
    border-radius: 6px;
    background: var(--ink);
    opacity: 0.85;
  }

  .bar.wide { width: 80%; }
  .mini:nth-child(2) .bar { background: var(--paper); }

  .dot {
    position: absolute;
    top: 36px;
    right: 36px;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--accent);
    border: var(--border-w) solid var(--border-color);
  }

  .mini b {
    font-family: var(--font-display);
    font-size: 150px;
    line-height: 0.8;
    color: var(--accent);
  }

  @media (max-width: 799px) {
    .cover {
      grid-template-columns: 1fr;
      align-content: center;
      gap: 36px;
    }

    .mark { margin-bottom: 22px; }
    .art { max-height: 240px; }
    .hero { margin-bottom: 18px; }

    .fan { height: 150px; }
    .mini { width: 170px; padding: 14px; gap: 7px; }
    .mini:nth-child(1) { top: 0; left: 0; }
    .mini:nth-child(2) { top: 26px; left: 120px; }
    .mini:nth-child(3) { top: 52px; left: 40px; }
    .bar { height: 8px; border-radius: 3px; }
    .dot { top: 12px; right: 12px; width: 22px; height: 22px; }
    .mini b { font-size: 54px; }
    .mini.focus { box-shadow: var(--shadow-card), 0 0 0 4px var(--paper-a35); }
  }
</style>
