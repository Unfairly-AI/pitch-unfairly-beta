---
// Pattern: before and after, in type. The topic title, struck through, becomes
// the sentence headline that replaces it. One card on the slide: the after.
import Slide from '../components/Slide.astro';
---

<Slide
  id="headlines"
  label="Say the point"
  tone="cyan"
  notes={`A topic title names a subject; a sentence headline makes a claim the audience can repeat. Every headline in this deck is a sentence.

Source: Garner, Alley, Wolfe and Sawarynski (2013), 110 students, identical narration: sentence headlines with visual evidence beat topic titles with bullets on comprehension (d = 0.81). The bracketed figure is a placeholder for your own number.`}
>
  <div class="story">
    <h2 class="display h-display rise">Say the point, then prove it.</h2>

    <div class="swap">
      <p class="topic rise" style="--d: 200ms"><s>Market</s></p>
      <span class="arrow rise" style="--d: 820ms" aria-hidden="true">→</span>
      <figure class="after rise" style="--d: 960ms">
        <p class="claim">Our buyers lose [a day] a week to reporting.</p>
        <figcaption>Sentence headlines beat topic titles on comprehension. <span class="src">Garner &amp; Alley, 2013</span></figcaption>
      </figure>
    </div>
  </div>
</Slide>

<style>
  .story { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 88px; }
  .h-display { max-width: 18ch; }

  .swap { display: grid; grid-template-columns: auto auto minmax(0, 1fr); align-items: center; gap: 56px; }

  .topic { margin: 0; font: 750 150px/1 var(--font-display); letter-spacing: -0.05em; color: color-mix(in oklab, var(--ink) 42%, transparent); }
  .topic s { position: relative; text-decoration: none; }
  .topic s::after {
    content: '';
    position: absolute;
    left: -5%;
    right: -5%;
    top: 54%;
    height: 0.09em;
    border-radius: 99px;
    background: var(--accent);
    transform: rotate(-5deg);
    transform-origin: left;
  }
  :global(.is-active) .topic s::after { animation: strike 380ms var(--ease) 620ms both; }
  @keyframes strike { from { transform: rotate(-5deg) scaleX(0); } }

  .arrow { font: 800 110px/1 var(--font-display); color: var(--accent-dark); }

  .after { display: grid; gap: 32px; min-width: 0; margin: 0; }

  /* The one card on the slide: the headline it writes instead. */
  .claim {
    margin: 0;
    padding: 44px 52px;
    border: var(--border-w) solid var(--border-color);
    border-radius: var(--radius);
    background: var(--paper);
    box-shadow: var(--shadow-card);
    font: 750 76px/1.02 var(--font-display);
    letter-spacing: -0.045em;
    text-wrap: balance;
    transform: rotate(calc(-1deg * var(--tilt)));
  }

  figcaption { font: 600 var(--t-body)/1.3 var(--font-body); text-wrap: pretty; }
  .src {
    display: inline-block;
    margin-left: 10px;
    padding: 6px 14px;
    border: 3px solid var(--border-color);
    border-radius: 999px;
    font: 700 var(--t-label)/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    vertical-align: 3px;
    white-space: nowrap;
  }

  @media (max-width: 799px) {
    .story { gap: 30px; }
    .swap { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 16px; }
    .topic { font-size: 52px; }
    .arrow { font-size: 40px; }
    .after { flex: 1 0 100%; gap: 16px; }
    .claim { padding: 18px 20px; font-size: 30px; }
    figcaption { font-size: 16px; }
    .src { display: table; margin: 8px 0 0; padding: 5px 9px; border-width: 2px; font-size: 13px; letter-spacing: 0.04em; }
  }
</style>
