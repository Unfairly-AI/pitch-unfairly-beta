---
// Pattern: one claim, shown three ways. A cluster of real artifacts (a browser,
// a phone, a file) overlapping like objects on a desk, each with a sticker
// naming what it does. No equal boxes in a row.
import Slide from '../components/Slide.astro';

const link = 'pitchunfairly.com/fizz/launch';
---

<Slide
  id="screens"
  label="Every screen"
  tone="yellow"
  notes="One deck, three ways out. Present it in the browser, text the link (it unfurls with a preview), or attach the PDF. Every deck is checked in all three before it ships: present mode, two phone sizes, and the exported PDF. Fizz Soda is made up."
>
  <div class="screens">
    <h2 class="display h-display rise">One link. <span class="hl">Every screen.</span></h2>

    <div class="cluster" aria-hidden="true">
      <figure class="browser rise" style="--d: 200ms">
        <div class="bar"><i></i><i></i><i></i><span class="url">{link}</span></div>
        <div class="mini"><p>The soda your gut <em>actually</em> likes.</p></div>
        <figcaption class="tag">Present it</figcaption>
      </figure>

      <figure class="phone rise" style="--d: 320ms">
        <div class="screen">
          <p class="bubble">Deck for Thursday</p>
          <div class="unfurl">
            <div class="mini"><p>The soda your gut <em>actually</em> likes.</p></div>
            <p class="u-title">Fizz Soda: Launch</p>
          </div>
        </div>
        <figcaption class="tag">Text it</figcaption>
      </figure>

      <figure class="file rise mobile-hide" style="--d: 440ms">
        <span class="file-icon">PDF</span>
        <span class="file-name"><b>fizz-launch.pdf</b><small>6 pages</small></span>
        <figcaption class="tag">Attach it</figcaption>
      </figure>
    </div>
  </div>
</Slide>

<style>
  .screens { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 64px; }
  .h-display { margin: 0; }

  /* A browser up front, a phone over its corner, the PDF tucked beside. */
  .cluster { position: relative; height: 560px; }
  figure { margin: 0; }

  .tag {
    position: absolute;
    padding: 10px 18px;
    border: var(--border-w) solid var(--border-color);
    border-radius: 999px;
    background: var(--paper);
    font: 800 28px/1 var(--font-display);
    letter-spacing: -0.01em;
    white-space: nowrap;
    box-shadow: 5px 5px 0 var(--border-color);
  }

  .browser {
    position: absolute;
    left: 0;
    top: 0;
    width: 900px;
    border: var(--border-w) solid var(--border-color);
    border-radius: 22px;
    background: var(--paper);
    box-shadow: var(--shadow-card);
  }
  .bar { display: flex; align-items: center; gap: 10px; padding: 14px 18px; border-bottom: var(--border-w) solid var(--border-color); }
  .bar i { width: 14px; height: 14px; border: 3px solid var(--border-color); border-radius: 50%; }
  .url { margin-left: 14px; padding: 6px 16px; border-radius: 999px; background: var(--tint-2); font: 600 22px/1 var(--font-mono); }
  .browser .tag { left: -18px; bottom: -22px; transform: rotate(-4deg); }

  /* The made-up company's cover, sized in container units so it scales as one piece. */
  .mini {
    container-type: inline-size;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: flex-end;
    padding: 7cqi;
    background: var(--c-cyan, var(--accent-2));
  }
  .browser .mini { border-radius: 0 0 16px 16px; }
  .mini p { max-width: 12ch; margin: 0; font: 800 9.5cqi/0.98 var(--font-display); letter-spacing: -0.04em; text-wrap: balance; color: var(--ink); }
  .mini em { font-style: normal; color: var(--accent); }

  .phone {
    position: absolute;
    left: 820px;
    top: 60px;
    width: 300px;
    height: 560px;
    padding: 12px;
    border: var(--border-w) solid var(--border-color);
    border-radius: 48px;
    background: var(--ink);
    box-shadow: var(--shadow-card);
    transform: rotate(calc(3deg * var(--tilt)));
  }
  .screen { height: 100%; display: flex; flex-direction: column; justify-content: flex-end; gap: 14px; padding: 18px 16px; border-radius: 36px; background: var(--paper); }
  .bubble { align-self: flex-end; margin: 0; padding: 12px 18px; border-radius: 22px 22px 6px 22px; background: var(--accent); color: var(--on-accent); font: 600 22px/1.2 var(--font-body); }
  .unfurl { align-self: flex-end; width: 92%; overflow: hidden; border: 3px solid var(--border-color); border-radius: 20px; background: var(--paper); }
  .u-title { margin: 0; padding: 10px 14px 12px; font: 700 20px/1.2 var(--font-display); }
  .phone .tag { right: -30px; bottom: 70px; transform: rotate(5deg); }

  .file {
    position: absolute;
    left: 1240px;
    top: 250px;
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 22px 28px;
    border: var(--border-w) solid var(--border-color);
    border-radius: 22px;
    background: var(--paper);
    transform: rotate(calc(-2deg * var(--tilt)));
  }
  .file-icon { display: grid; place-items: center; width: 64px; height: 80px; border-radius: 10px; background: var(--accent); color: var(--on-accent); font: 800 20px/1 var(--font-mono); }
  .file-name { display: grid; gap: 6px; }
  .file-name b { font: 700 28px/1.1 var(--font-display); }
  .file-name small { font: 500 var(--t-label)/1 var(--font-mono); color: var(--ink-muted); }
  .file .tag { right: -24px; top: -30px; transform: rotate(4deg); }

  @media (max-width: 799px) {
    .screens { gap: 24px; }
    .cluster { height: auto; display: flex; align-items: flex-end; gap: 0; padding-bottom: 18px; }
    .browser { position: relative; width: 80%; border-radius: 12px; }
    .bar { gap: 5px; padding: 7px 9px; }
    .bar i { width: 7px; height: 7px; border-width: 2px; }
    .url { display: none; }
    .browser .mini { border-radius: 0 0 8px 8px; }
    .phone { position: relative; left: auto; top: auto; width: 38%; height: auto; aspect-ratio: 9 / 17; margin-left: -8%; padding: 5px; border-radius: 20px; }
    .screen { gap: 6px; padding: 8px 6px; border-radius: 15px; }
    .bubble { padding: 5px 8px; border-radius: 10px 10px 3px 10px; font-size: 9px; }
    .unfurl { border-width: 2px; border-radius: 9px; }
    .u-title { padding: 4px 6px 6px; font-size: 8px; }
    .tag { padding: 4px 8px; border-width: 2px; font-size: 12px; box-shadow: 2px 2px 0 var(--border-color); }
    .browser .tag { left: -6px; bottom: -12px; }
    .phone .tag { display: none; }
  }
</style>
