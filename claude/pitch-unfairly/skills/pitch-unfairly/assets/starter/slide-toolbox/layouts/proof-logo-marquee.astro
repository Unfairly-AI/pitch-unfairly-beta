---
/**
 * proof-logo-marquee: more customers than one row holds, drifting past.
 *
 * The headline says what the list proves; under it, one strip of logos moves
 * sideways at reading pace while the slide is on screen (the motion kit's
 * Marquee), with a pause button. The PDF, reduced motion and a phone at rest
 * show every logo once, wrapped and still.
 */
import Slide from '../../src/components/Slide.astro';
import Marquee from '../../src/components/motion/Marquee.astro';
import { layoutRule, fitType, splitHl, type SlideBase } from '../lib';

interface Props extends SlideBase {
  /** What the list proves, as a sentence. 14 words or fewer. */
  headline: string;
  /** One phrase of the headline, word for word, in the accent. */
  hl?: string;
  /** One quiet line under the strip: what the logos have in common, or the count. 90 characters or fewer. */
  line?: string;
  /** Six to twenty-four customers: a logo URL each, or the name set in type. */
  logos: { name: string; logo?: string }[];
}

const { id, label = 'Customers', tone = 'paper', notes, brand, headline, hl, line, logos } = Astro.props;
const where = `proof-logo-marquee "${id}"`;
if (headline.split(/\s+/).length > 14) layoutRule(where, `${where}: the headline is ${headline.split(/\s+/).length} words; keep it to 14 or fewer.`);
if (line && line.length > 90) layoutRule(where, `${where}: the line is ${line.length} characters; keep it to 90 or fewer.`);
if (logos.length < 6 || logos.length > 24) throw new Error(`${where}: six to twenty-four logos (got ${logos.length}). Fewer fit a still wall (proof-logo-wall).`);
const [before, phrase, after] = splitHl(headline, hl, where);
const head = fitType(headline.length, { width: 1500, lines: 2, min: 72, max: 124 });
const phone = fitType(headline.length, { width: 330, lines: 3, min: 26, max: 40 });
---

<Slide id={id} label={label} tone={tone} notes={notes} brand={brand}>
  <div class="st-drift" style={`--head: ${head}px; --head-phone: ${phone}px`}>
    <h2 data-fit="2 4" class="display st-drift-head rise">
      <slot name="headline">{before}{phrase && <span class="hl">{phrase}</span>}{after}</slot>
    </h2>
    <div class="st-drift-strip rise" style="--d: 200ms">
      <Marquee logos={logos.map((l) => ({ src: l.logo, alt: l.name }))} height={64} />
    </div>
    {line && <p class="st-drift-line rise" style="--d: 320ms">{line}</p>}
  </div>
</Slide>

<style>
  .st-drift {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-rows: auto 1fr auto;
    row-gap: calc(var(--gap) * 1.2);
  }

  .st-drift-head {
    max-width: 1500px;
    font-size: calc(var(--head) * var(--display-scale));
  }

  .st-drift-strip {
    align-self: center;
    margin: 0 calc(var(--pad-x) * -1);
    padding: 0 var(--pad-x);
  }

  .st-drift-line {
    font-size: var(--t-body);
    color: color-mix(in oklab, currentColor 70%, transparent);
  }

  @media (max-width: 799px) {
    .st-drift { grid-template-rows: auto auto auto; align-content: start; row-gap: calc(var(--gap) * 1.4); }
    .st-drift-head { font-size: calc(var(--head-phone) * var(--display-scale)); }
    .st-drift-strip { margin: 0; padding: 0; }
  }

  /* PDF and every static render: every logo once, wrapped and still (Marquee's still state). */
  :global(html.is-static) .st-drift .rise {
    opacity: 1;
    transform: none;
  }
</style>
