---
/**
 * problem-moment-photo: the moment the problem happens, as a photograph.
 *
 * A photo of the real moment (the depot at 6am, the queue at the counter, the
 * desk under the paper) bleeds off one side of the slide, edge to edge, top to
 * bottom. On it, at the corner, a small time-and-place tag says when and where
 * this is, like a camera's own stamp. The other side holds the headline, low,
 * at the largest size its column takes, and one quiet line under it with the
 * cost. The photo is the focal element; the type stays on the tone, never on
 * the photo, so it reads on any picture.
 */
import Slide from '../../src/components/Slide.astro';
import { layoutRule, fitType, splitHl, type SlideBase } from '../lib';

interface Props extends SlideBase {
  /** The point, in a whole sentence. 14 words or fewer. */
  headline: string;
  /** One phrase of the headline, word for word, in the accent. */
  hl?: string;
  /** One quiet line under the headline that adds a fact: what the moment costs. 20 words or fewer. */
  caption?: string;
  /** The photo of the moment: a URL or a path under public/. The customer's own beats stock. */
  photo: string;
  /** What the photo shows, for screen readers and the PDF. */
  alt: string;
  /** When and where, set on the photo's corner: "6:04am, Eastside depot". 32 characters or fewer. */
  moment?: string;
  /** Which side the photo bleeds off. Default "right". */
  side?: 'left' | 'right';
  /** Required. The point of the photo to keep in frame when it's cropped, as CSS object-position ("60% 30%"): a person's face (their eyes), else the photo's own subject. Look at the photo at full size and at the slide's crop before you set it: the crop never cuts a head off at the eyes or leaves a torso without its face. */
  focus: string;
}

const { id, label = 'Problem', tone = 'ink', notes, brand, headline, hl, caption, photo, alt, moment, side = 'right', focus } = Astro.props;
const where = `problem-moment-photo "${id}"`;
if (!focus || !/^\d{1,3}% \d{1,3}%$/.test(focus)) throw new Error(`${where}: focus is required, as "x% y%": the point of the photo to keep in frame, a person's face or the photo's own subject. Look at the photo at the slide's crop and set it; the centre crop cuts heads off.`);
if (!photo) throw new Error(`${where}: photo is required; without a photo of the moment, use problem-artifact or statement.`);
if (!alt) throw new Error(`${where}: alt is required; say what the photo shows.`);
if (moment && moment.length > 32) layoutRule(where, `${where}: moment is ${moment.length} characters; a time and a place, 32 or fewer.`);
if (caption && caption.split(/\s+/).length > 20) layoutRule(where, `${where}: caption is ${caption.split(/\s+/).length} words; one line of 20 or fewer, the rest in the notes.`);
const [before, phrase, after] = splitHl(headline, hl, where);
// Half the slide, less its outer padding and the gutter to the photo.
const stage = fitType(headline.length, { width: 720, lines: 3, min: 68, max: 116 });
const phone = fitType(headline.length, { width: 340, lines: 4, min: 26, max: 40 });
---

<Slide id={id} label={label} tone={tone} notes={notes} brand={brand}>
  <div class:list={['st-moment', `is-${side}`]} style={`--fit: ${stage}px; --fit-phone: ${phone}px; --focus: ${focus}`}>
    <figure class="st-moment-photo" data-bleed>
      <img src={photo} alt={alt} />
      {moment && <figcaption class="st-moment-tag rise" style="--d: 420ms">{moment}</figcaption>}
    </figure>
    <div class="st-moment-text">
      <h2 data-fit="3 4" class="display st-moment-head rise" style="--d: 120ms">
        <slot name="headline">{before}{phrase && <span class="hl">{phrase}</span>}{after}</slot>
      </h2>
      {caption && <p class="st-moment-cap rise" style="--d: 260ms">{caption}</p>}
    </div>
  </div>
</Slide>

<style>
  /* The photo bleeds, so the layout takes the whole slide and pads its text side itself. */
  .st-moment {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .st-moment-photo {
    position: relative;
    grid-row: 1;
    min-height: 0;
    overflow: hidden;
  }

  .st-moment.is-right .st-moment-photo { grid-column: 2; }
  .st-moment.is-left .st-moment-photo { grid-column: 1; }

  .st-moment-photo img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: var(--focus);
  }

  /* The camera's stamp: when and where, on a scrim of the night tone so it reads on any photo. */
  .st-moment-tag {
    position: absolute;
    left: 48px;
    bottom: 48px;
    padding: 12px 20px;
    border-radius: 6px;
    background: color-mix(in oklab, var(--night) 78%, transparent);
    color: var(--on-night);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--caps-tracking, 0.12em);
    text-transform: var(--label-case, uppercase);
    font-variant-numeric: tabular-nums;
  }

  .st-moment-text {
    grid-row: 1;
    align-self: end;
    padding: var(--pad-y) calc(var(--gap) * 1.3) calc(var(--pad-y) * 1.15) var(--pad-x);
  }

  .st-moment.is-right .st-moment-text { grid-column: 1; }

  .st-moment.is-left .st-moment-text {
    grid-column: 2;
    padding: var(--pad-y) var(--pad-x) calc(var(--pad-y) * 1.15) calc(var(--gap) * 1.3);
  }

  .st-moment-head {
    font-size: calc(var(--fit) * var(--display-scale));
    line-height: min(var(--display-line), 1);
  }

  .st-moment-head .hl { white-space: nowrap; }

  .st-moment-cap {
    margin-top: calc(var(--gap) * 0.75);
    max-width: 640px;
    font-size: var(--t-lede);
    line-height: 1.3;
    color: color-mix(in oklab, currentColor 74%, transparent);
    text-wrap: pretty;
  }

  :global(.tone-ink) .st-moment-head { letter-spacing: calc(var(--display-tracking) * 0.85); }

  /* The page number sits on the photo when it bleeds right: give it the tag's scrim. */
  :global(.slide:has(> .st-moment.is-right) > .slide-num) {
    z-index: 1;
    padding: 6px 12px;
    border-radius: 6px;
    background: color-mix(in oklab, var(--night) 78%, transparent);
    color: var(--on-night);
    opacity: 1;
  }

  /* Phone: the photo across the top, the headline and the line under it. */
  @media (max-width: 799px) {
    .st-moment,
    .st-moment.is-left,
    .st-moment.is-right {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 48% minmax(0, 1fr);
    }

    .st-moment.is-left .st-moment-photo,
    .st-moment.is-right .st-moment-photo {
      grid-column: 1;
      grid-row: 1;
    }

    .st-moment.is-left .st-moment-text,
    .st-moment.is-right .st-moment-text {
      grid-column: 1;
      grid-row: 2;
      align-self: start;
      padding: 26px var(--pad-x) 40px;
    }

    .st-moment-tag {
      left: 14px;
      bottom: 14px;
      padding: 6px 10px;
      font-size: 13px;
    }

    .st-moment-head { font-size: calc(var(--fit-phone) * var(--display-scale)); }
    .st-moment-cap { margin-top: 14px; max-width: none; }

    :global(.slide:has(> .st-moment.is-right) > .slide-num) {
      padding: 0;
      background: none;
      color: inherit;
      opacity: 0.45;
    }
  }

  /* PDF and every static render: the photo prints at its crop, the tag and the type in place. */
  :global(html.is-static) .st-moment .rise {
    opacity: 1;
    transform: none;
  }
</style>
