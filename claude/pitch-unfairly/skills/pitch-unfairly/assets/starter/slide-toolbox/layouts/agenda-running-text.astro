---
/**
 * agenda-running-text: the meeting's map as one run of very large type.
 *
 * Every part of the meeting flows as a single paragraph, each name followed by
 * where it starts. The part about to begin is full strength and underlined in
 * the accent; the rest step back. Shown again before each part with the next
 * one lit, it is the deck's "you are here". With no current part, every name
 * reads at full strength and the type alone carries the slide. A short
 * headline at the top says where the room is, quietly.
 */
import Slide from '../../src/components/Slide.astro';
import { layoutRule, fitType, type SlideBase } from '../lib';

interface Props extends SlideBase {
  /** The parts of the meeting, in order: two to six, each a name of four words or fewer and, optionally, where it starts (a slide number or a time: "07", "10:15"). */
  items: { title: string; at?: string }[];
  /** Which part is about to begin, counting from 1. It is lit and the rest step back. */
  current?: number;
  /** Where the room is, as a short sentence set quietly at the top: "Next, what it costs." Eight words or fewer. */
  headline: string;
}

const { id, label = 'Agenda', tone = 'ink', notes, brand, items, current, headline } = Astro.props;
const where = `agenda-running-text "${id}"`;
if (items.length < 2 || items.length > 6) throw new Error(`${where}: two to six parts (got ${items.length}). A longer agenda is a contents page: group it.`);
for (const it of items) if (it.title.split(/\s+/).length > 4) layoutRule(where, `${where}: "${it.title}" is over four words; a part's name is short enough to say in a breath.`);
if (current !== undefined && (current < 1 || current > items.length)) throw new Error(`${where}: current ${current} is outside 1 to ${items.length}.`);
if (headline.split(/\s+/).length > 8) layoutRule(where, `${where}: the headline is ${headline.split(/\s+/).length} words; it is a quiet line of eight or fewer. The parts carry the slide.`);
// Each "at" is set at half size, so it counts for half.
const chars = items.reduce((n, it) => n + it.title.length + 1 + (it.at ? Math.ceil((it.at.length + 1) / 2) : 0), 0);
// Each part is kept whole on its line, so the longest one must fit the width too.
const longest = Math.max(...items.map((it) => it.title.length + (it.at ? Math.ceil((it.at.length + 1) / 2) : 0)));
const stage = Math.min(fitType(chars, { width: 1648, lines: 4, min: 76, max: 150 }), Math.floor(1560 / (longest * 0.6)));
// On a phone a part may break across lines, so only the whole run is fitted.
const phone = fitType(chars, { width: 300, lines: 7, min: 24, max: 40 });
---

<Slide id={id} label={label} tone={tone} notes={notes} brand={brand}>
  <nav class:list={['st-run', { 'has-current': current !== undefined }]} aria-label={label} style={`--fit: ${stage}px; --fit-phone: ${phone}px`}>
    <h2 data-fit="2 4" class="st-run-head rise">{headline}</h2>
    <ol data-fit="0" class="display st-run-list">
      {items.map((it, i) => (
        <li class:list={['rise', { 'is-now': current === i + 1 }]} style={`--d: ${80 + i * 70}ms`} aria-current={current === i + 1 ? 'step' : undefined}>
          <span class="st-run-name">{it.title}</span>
          {it.at && <span class="st-run-at">{it.at}</span>}
        </li>
      ))}
    </ol>
  </nav>
</Slide>

<style>
  .st-run {
    flex: 1;
    min-height: 0;
    display: grid;
    /* One column no wider than the slide, whatever the run's longest word. */
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr auto;
  }

  /* Quiet: the parts are the focal element, this only says where the room is. */
  .st-run-head {
    grid-row: 1;
    max-width: 1100px;
    font-size: var(--t-lede);
    font-weight: 600;
    line-height: 1.25;
    color: color-mix(in oklab, currentColor 78%, transparent);
  }

  /* The focal element: the whole meeting as one paragraph, set low. */
  .st-run-list {
    grid-row: 3;
    font-size: calc(var(--fit) * var(--display-scale));
    line-height: max(var(--display-line), 1.1);
    text-wrap: pretty;
  }

  .st-run-list li {
    display: inline-block;
    margin-right: 0.36em;
    white-space: nowrap;
  }

  .st-run-at {
    margin-left: 0.16em;
    font-size: 0.5em;
    vertical-align: 0.72em;
    letter-spacing: 0;
    font-variant-numeric: lining-nums tabular-nums;
  }

  /* Everything but the current part steps back; the current part is full
     strength and underlined in the accent. */
  .has-current li:not(.is-now) { color: color-mix(in oklab, currentColor 46%, transparent); }

  .st-run-list .is-now .st-run-name {
    text-decoration: underline;
    text-decoration-color: var(--hl-color);
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.14em;
  }

  .st-run-list .is-now .st-run-at { color: var(--hl-color); }

  :global(.tone-ink) .st-run-list { letter-spacing: calc(var(--display-tracking) * 0.85); }
    :global(.tone-accent) .st-run-list .is-now .st-run-at { color: var(--on-accent); }
  :global(.tone-accent) .st-run-list .is-now .st-run-name { text-decoration-color: var(--on-accent); }

  /* Phone: the same run of type, at the largest size that fits the screen. */
  @media (max-width: 799px) {
    .st-run-at { font-size: max(0.5em, 13px); }
    .st-run-list li { display: inline; white-space: normal; }

    .st-run-list {
      font-size: calc(var(--fit-phone) * var(--display-scale));
      line-height: max(var(--display-line), 1.14);
    }
  }

  /* PDF and every static render: every part in place, the current one lit. */
  :global(html.is-static) .st-run .rise {
    opacity: 1;
    transform: none;
  }
</style>
