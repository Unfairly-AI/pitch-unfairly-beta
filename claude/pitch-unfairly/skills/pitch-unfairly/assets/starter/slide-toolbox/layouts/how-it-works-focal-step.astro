---
/**
 * how-it-works-focal-step: the whole process on one line, one step opened up.
 *
 * The headline at the top. Under it, every step sits on a single hairline as
 * a small dot and its name, quiet. The step that sets the company apart is a
 * large numbered node in the accent, and a line drops from it to that step
 * opened up: its name in the display face and one or two lines on what it
 * does. Generic steps stay on the line; the one that matters gets the room.
 */
import Slide from '../../src/components/Slide.astro';
import { fitType, splitHl, type SlideBase } from '../lib';

interface Props extends SlideBase {
  /** What the process does, as a whole sentence. 12 words or fewer. */
  headline: string;
  /** One phrase of the headline, word for word, in the accent. Then the focal node goes quiet. */
  hl?: string;
  /** Three to six steps in order, each a name of four words or fewer. The focal step also needs its detail. */
  steps: { name: string; detail?: string }[];
  /** The step that sets the company apart, by position from 1. Its detail is required: 120 characters or fewer. */
  focus: number;
}

const { id, label = 'How it works', tone = 'paper', notes, brand, headline, hl, steps, focus } = Astro.props;
const where = `how-it-works-focal-step "${id}"`;
if (!steps || steps.length < 3 || steps.length > 6) throw new Error(`${where}: three to six steps (got ${steps?.length ?? 0}). Fewer is a statement; more needs grouping into phases.`);
if (!(focus >= 1 && focus <= steps.length)) throw new Error(`${where}: focus ${focus} isn't a step; number them from 1 to ${steps.length}.`);
steps.forEach((s, i) => {
  if (s.name.split(/\s+/).length > 4) throw new Error(`${where}: step ${i + 1}'s name "${s.name}" is over four words. Shorten it; the focal step's detail carries the explanation.`);
});
const hero = steps[focus - 1]!;
if (!hero.detail) throw new Error(`${where}: step ${focus} is the focus, so it needs a detail: one or two lines on what it does.`);
if (hero.detail.length > 120) throw new Error(`${where}: step ${focus}'s detail is ${hero.detail.length} characters; 120 or fewer.`);
const [before, phrase, after] = splitHl(headline, hl, where);
const head = fitType(headline.length, { width: 1400, lines: 2, min: 72, max: 112 });
const phone = fitType(headline.length, { width: 330, lines: 3, min: 26, max: 40 });
// The opened step spans enough columns for about 760px of text, starting at its node where it fits.
const n = steps.length;
const span = Math.min(n, Math.ceil(760 / (1648 / n)));
const start = Math.min(focus, n - span + 1);
---

<Slide id={id} label={label} tone={tone} notes={notes} brand={brand}>
  <div class:list={['st-focal', { 'has-hl': !!phrase }]} style={`--head: ${head}px; --head-phone: ${phone}px; --n: ${n}; --f: ${focus}; --start: ${start}; --span: ${span}`}>
    <h2 data-fit="2 3" class="display st-focal-head rise">
      <slot name="headline">{before}{phrase && <span class="hl">{phrase}</span>}{after}</slot>
    </h2>
    <ol class="st-focal-track">
      {steps.map((s, i) => (
        <li class:list={['st-focal-step', { 'is-focus': i + 1 === focus }]} style={`--d: ${200 + i * 90}ms`}>
          <span class:list={['st-focal-node', i + 1 === focus ? 'pop' : 'rise']} data-n={i + 1} aria-hidden="true"></span>
          <span class="st-focal-name rise">{s.name}</span>
          {i + 1 === focus && <span class="st-focal-drop rise" style={`--d: ${300 + n * 90}ms`} aria-hidden="true"></span>}
          {i + 1 === focus && <p class="st-focal-phone-detail">{s.detail}</p>}
        </li>
      ))}
    </ol>
    <div class="st-focal-open">
      <div class="st-focal-panel rise" style={`--d: ${380 + n * 90}ms`}>
        <h3 class="display st-focal-title">{hero.name}</h3>
        <p class="st-focal-detail">{hero.detail}</p>
      </div>
    </div>
  </div>
</Slide>

<style>
  .st-focal {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    grid-template-rows: auto minmax(0, 1fr) auto auto minmax(0, 0.3fr);
  }

  .st-focal-head {
    grid-column: 1 / -1;
    max-width: 1400px;
    font-size: calc(var(--head) * var(--display-scale));
  }

  /* Every step on one hairline: a small dot and its name. */
  .st-focal-track {
    grid-row: 3;
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    position: relative;
  }

  .st-focal-track::before {
    content: '';
    position: absolute;
    top: 32px;
    left: 0;
    right: 0;
    border-top: 1px solid color-mix(in oklab, currentColor 30%, transparent);
  }

  .st-focal-step {
    position: relative;
    display: grid;
    grid-template-rows: 64px auto;
    row-gap: 18px;
    padding-right: 24px;
  }

  .st-focal-node {
    align-self: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: color-mix(in oklab, currentColor 55%, var(--paper));
  }

  .st-focal-name {
    font-size: var(--t-body);
    line-height: 1.2;
    color: color-mix(in oklab, currentColor 64%, transparent);
  }

  .st-focal-phone-detail { display: none; }

  /* The focal step: a large numbered node in the accent. Its name moves to the panel below. */
  .st-focal-step.is-focus .st-focal-node {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin-left: -23px;
    background: var(--hl-color);
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 30px;
    font-variant-numeric: tabular-nums;
  }

  /* The number is drawn, so text readers take the steps in order without it. */
  .st-focal-step.is-focus .st-focal-node::before { content: attr(data-n); }
  .st-focal-step.is-focus .st-focal-name { visibility: hidden; }

  .st-focal.has-hl .st-focal-step.is-focus .st-focal-node { background: var(--ink); color: var(--paper); }
  :global(.tone-ink) .st-focal-step.is-focus .st-focal-node { color: var(--night); }
  :global(.tone-ink) .st-focal.has-hl .st-focal-step.is-focus .st-focal-node { background: var(--on-night); }

  /* The step opened up, hung from its node by a hairline drop. */
  .st-focal-open {
    grid-row: 4;
    grid-column: var(--start) / span var(--span);
    position: relative;
    padding-top: calc(var(--gap) * 1.3);
  }

  /* From the focal node's foot, through the track, to the opened step. */
  .st-focal-drop {
    position: absolute;
    top: 64px;
    bottom: calc(var(--gap) * -1.05);
    left: 8px;
    border-left: 2px solid var(--hl-color);
  }

  .st-focal.has-hl .st-focal-drop { border-left-color: currentColor; }

  .st-focal-panel {
    padding-left: calc((var(--f) - var(--start)) * 100% / var(--span));
    max-width: 960px;
  }

  .st-focal-title {
    font-size: var(--t-title);
    line-height: 1;
  }

  .st-focal-detail {
    max-width: 34ch;
    margin-top: 18px;
    font-size: var(--t-lede);
    line-height: 1.3;
    color: color-mix(in oklab, currentColor 78%, transparent);
    text-wrap: pretty;
  }

  /* Phone: the line runs down the left edge; the focal step opens in place. */
  @media (max-width: 799px) {
    .st-focal {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto;
      align-content: start;
      row-gap: calc(var(--gap) * 1.4);
    }

    .st-focal-head { max-width: none; font-size: calc(var(--head-phone) * var(--display-scale)); }
    .st-focal-track { grid-row: 2; display: grid; grid-template-columns: minmax(0, 1fr); row-gap: 14px; }

    .st-focal-track::before {
      top: 6px;
      bottom: 6px;
      left: 8px;
      right: auto;
      border-top: 0;
      border-left: 1px solid color-mix(in oklab, currentColor 30%, transparent);
    }

    .st-focal-step {
      grid-template-columns: 18px minmax(0, 1fr);
      grid-template-rows: auto;
      column-gap: 16px;
      row-gap: 4px;
      padding: 0;
    }

    .st-focal-node { width: 14px; height: 14px; margin-left: 2px; }
    .st-focal-step.is-focus .st-focal-node { width: 32px; height: 32px; margin-left: -7px; font-size: 16px; }
    .st-focal-step.is-focus .st-focal-name { visibility: visible; font-family: var(--font-display); font-weight: var(--display-weight); font-size: var(--t-title); line-height: 1.05; color: currentColor; }
    .st-focal-phone-detail { display: block; grid-column: 2; font-size: var(--t-body); line-height: 1.35; color: color-mix(in oklab, currentColor 78%, transparent); }
    .st-focal-open,
    .st-focal-drop { display: none; }
  }

  /* PDF and every static render: the step is already opened. */
  :global(html.is-static) .st-focal .rise,
  :global(html.is-static) .st-focal .pop {
    opacity: 1;
  }
</style>
