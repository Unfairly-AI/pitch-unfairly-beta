---
/**
 * ask-line-button: the close as one request and the one thing to press.
 *
 * The ask fills the left at the largest size that fits three lines, with at
 * most one line of terms under it. On the right, one round button at scale,
 * ringed twice, carrying the next step: a real link when there is one (a
 * calendar, a signature, a reply). One request, one action, nothing else. On a
 * phone the button becomes a full-width bar at the foot, under the thumb.
 */
import Slide from '../../src/components/Slide.astro';
import { layoutRule, fitType, splitHl, type SlideBase } from '../lib';

interface Props extends SlideBase {
  /** The ask: one whole sentence, 12 words or fewer, saying what you want them to do. */
  headline: string;
  /** One phrase of the headline, word for word, to set in the accent. */
  hl?: string;
  /** One line of terms under the ask (when, how long, who): 80 characters or fewer. */
  detail?: string;
  /** The button: its label (a verb phrase, 24 characters or fewer) and, when it does something, where it goes (a calendar link, a mailto:). */
  button: { label: string; href?: string };
}

const { id, label = 'Ask', tone = 'ink', notes, brand, headline, hl, detail, button } = Astro.props;
const where = `ask-line-button "${id}"`;
if (headline.split(/\s+/).length > 14) layoutRule(where, `${where}: the ask is ${headline.split(/\s+/).length} words; an ask is 12 or fewer. Cut it.`);
if (detail && detail.length > 80) layoutRule(where, `${where}: detail is ${detail.length} characters; one line of terms is 80 or fewer. The rest goes in the notes.`);
if (!button?.label) throw new Error(`${where}: button.label is required: the next step, as a verb ("Book the pilot call").`);
if (button.label.length > 24) layoutRule(where, `${where}: the button label is ${button.label.length} characters; a button is 24 or fewer.`);
const [before, phrase, after] = splitHl(headline, hl, where);
const stage = fitType(headline.length, { width: 1000, lines: 3, min: 92, max: 148 });
const phone = fitType(headline.length, { width: 330, lines: 4, min: 30, max: 50 });
const external = button.href && /^https?:/.test(button.href);
---

<Slide id={id} label={label} tone={tone} notes={notes} brand={brand}>
  <div class="st-askb" style={`--fit: ${stage}px; --fit-phone: ${phone}px`}>
    <div class="st-askb-text">
      <h2 data-fit="3 4" class="display st-askb-line rise">
        <slot name="headline">{before}{phrase && <span class="hl">{phrase}</span>}{after}</slot>
      </h2>
      {detail && <p class="st-askb-detail rise" style="--d: 200ms">{detail}</p>}
    </div>
    <div class="st-askb-act">
      <span class="st-askb-ring pop" style="--d: 360ms" aria-hidden="true"></span>
      <span class="st-askb-ring is-outer pop" style="--d: 460ms" aria-hidden="true"></span>
      {button.href ? (
        <a class="st-askb-btn pop" style="--d: 260ms" href={button.href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
          <span>{button.label}</span>
          <svg viewBox="0 0 48 24" aria-hidden="true"><path d="M2 12h42M34 3l10 9-10 9" /></svg>
        </a>
      ) : (
        <span class="st-askb-btn pop" style="--d: 260ms">
          <span>{button.label}</span>
          <svg viewBox="0 0 48 24" aria-hidden="true"><path d="M2 12h42M34 3l10 9-10 9" /></svg>
        </span>
      )}
    </div>
  </div>
</Slide>

<style>
  .st-askb {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 640px;
    align-items: center;
    column-gap: var(--gap);
  }

  .st-askb-line {
    font-size: calc(var(--fit) * var(--display-scale));
    line-height: min(var(--display-line), 1);
  }


  .st-askb-detail {
    margin-top: calc(var(--gap) * 0.9);
    font-size: var(--t-lede);
    line-height: 1.3;
    max-width: 860px;
    color: color-mix(in oklab, currentColor 74%, transparent);
  }

  /* The action: one round button at scale, ringed twice. */
  .st-askb-act {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
  }

  .st-askb-act > * { grid-area: 1 / 1; }

  .st-askb-ring {
    width: 78%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid color-mix(in oklab, currentColor 26%, transparent);
  }

  .st-askb-ring.is-outer {
    width: 100%;
    border-color: color-mix(in oklab, currentColor 13%, transparent);
  }

  .st-askb-btn {
    --btn: var(--accent);
    --btn-ink: var(--on-accent);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    width: 56%;
    aspect-ratio: 1;
    padding: 40px;
    border-radius: 50%;
    background: var(--btn);
    color: var(--btn-ink);
    box-shadow: var(--shadow-focal);
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: var(--t-lede);
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-align: center;
    text-decoration: none;
    text-wrap: balance;
    transition: scale var(--dur-hover) var(--ease-hover);
  }

  .st-askb-btn svg {
    width: 56px;
    height: 28px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform var(--dur-hover) var(--ease-hover);
  }

  a.st-askb-btn:hover { scale: 1.03; }
  a.st-askb-btn:hover svg { transform: translateX(6px); }

  a.st-askb-btn:focus-visible {
    outline: 4px solid currentColor;
    outline-offset: -14px;
  }

  /* The button reads on every tone: the dark tone's accent is light, so its
     label goes dark; on an accent field the button turns to paper. */
  :global(.tone-ink) .st-askb-btn { --btn-ink: var(--night); }
  :global(.tone-accent) .st-askb-btn { --btn: var(--paper); --btn-ink: var(--ink); }
  :global(.tone-ink) .st-askb-line { letter-spacing: calc(var(--display-tracking) * 0.85); }

  /* Phone: the ask, its terms, then the button as a full-width bar at the foot. */
  @media (max-width: 799px) {
    .st-askb {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 1fr auto;
      align-items: end;
      row-gap: calc(var(--gap) * 2);
      /* Clear the page number under the button. */
      padding-bottom: 18px;
    }

    .st-askb-line { font-size: calc(var(--fit-phone) * var(--display-scale)); }
    .st-askb-detail { margin-top: 14px; }
    .st-askb-act { aspect-ratio: auto; }
    .st-askb-ring { display: none; }

    .st-askb-btn {
      flex-direction: row;
      justify-content: space-between;
      width: 100%;
      min-height: 64px;
      aspect-ratio: auto;
      padding: 16px 22px;
      border-radius: var(--radius-button, 999px);
      font-size: 18px;
      text-align: left;
    }

    .st-askb-btn svg { width: 32px; height: 16px; flex: none; }
    a.st-askb-btn:focus-visible { outline-offset: 3px; }
  }

  /* PDF and every static render: the button and its rings rest in place; the
     link still works in the PDF. */
  :global(html.is-static) .st-askb .rise,
  :global(html.is-static) .st-askb .pop {
    opacity: 1;
    transform: none;
  }
</style>
