---
/**
 * stats-hero-row: two to four figures on one baseline, one of them the hero.
 *
 * The headline across the top. Low on the slide, under one hairline, the
 * figures stand in a single row on a shared baseline: the hero in the accent
 * at poster size in a column twice as wide, counting up; the others in ink at
 * a third of its size, so the eye lands on the hero and reads the rest as its
 * support. Each figure's label sits under it on a shared line. No boxes.
 */
import Slide from '../../src/components/Slide.astro';
import CountUp from '../../src/components/motion/CountUp.astro';
import { figureEm, fitType, splitHl, unitScale, type SlideBase } from '../lib';

interface Stat {
  /** The figure as written, digits only: "94", "2.4", "1,186". */
  number: string;
  /** Set before the figure, smaller: "$". */
  prefix?: string;
  /** Set after the figure: "%", "x", or a short word ("hrs"). */
  unit?: string;
  /** What it measures, in a few words: "First-visit fix rate". 40 characters or fewer. */
  label: string;
}

interface Props extends SlideBase {
  /** The point the figures prove, in a whole sentence. 12 words or fewer. */
  headline: string;
  /** One phrase of the headline, word for word, in the accent. The hero figure then stays in the accent too: use sparingly. */
  hl?: string;
  /** Two to four figures, in reading order. */
  stats: Stat[];
  /** Which figure is the hero (0-based). Default 0, the first. */
  hero?: number;
}

const { id, label = 'Stats', tone = 'paper', notes, brand, headline, hl, stats, hero = 0 } = Astro.props;
const where = `stats-hero-row "${id}"`;
if (stats.length < 2 || stats.length > 4) throw new Error(`${where}: 2 to 4 stats (got ${stats.length}); one figure is big-number, more than four go in the notes.`);
if (!stats[hero]) throw new Error(`${where}: hero ${hero} isn't one of the ${stats.length} stats (0 to ${stats.length - 1}).`);
for (const s of stats) {
  if (!/\d/.test(s.number)) throw new Error(`${where}: "${s.number}" has no digits; a word goes in the label.`);
  if (s.label.length > 40) throw new Error(`${where}: label "${s.label}" is ${s.label.length} characters; 40 or fewer.`);
}
const [before, phrase, after] = splitHl(headline, hl, where);
const gap = 72;
const unitW = (1648 - gap * (stats.length - 1)) / (stats.length + 1.4);
const heroW = unitW * 2.4;
const size = (s: Stat, w: number, max: number) => Math.round(Math.min(max, w / figureEm(s.number, s.prefix, s.unit)));
const heroFig = size(stats[hero]!, heroW * 0.88, 400);
const restFig = Math.min(Math.round(heroFig / 3), ...stats.filter((_, i) => i !== hero).map((s) => size(s, unitW, 140)));
const heroPhone = size(stats[hero]!, 330, 150);
const cols = stats.map((_, i) => (i === hero ? '2.4fr' : '1fr')).join(' ');
const head = fitType(headline.length, { width: 1500, lines: 2, min: 72, max: 116 });
const headPhone = fitType(headline.length, { width: 330, lines: 4, min: 26, max: 40 });
const plain = (n: string) => /^\d+(\.\d+)?$/.test(n);
---

<Slide id={id} label={label} tone={tone} notes={notes} brand={brand}>
  <div class="st-row" style={`--head: ${head}px; --head-phone: ${headPhone}px; --hero: ${heroFig}px; --rest: ${restFig}px; --hero-phone: ${heroPhone}px; --cols: ${cols}; --gap-x: ${gap}px`}>
    <h2 data-fit="2 4" class="display st-row-head rise">
      <slot name="headline">{before}{phrase && <span class="hl">{phrase}</span>}{after}</slot>
    </h2>
    <ul class="st-row-stats">
      {stats.map((s, i) => (
        <li class:list={['st-row-stat', { 'is-hero': i === hero }, 'rise']} style={`--d: ${i === hero ? 160 : 420 + i * 80}ms; --unit: ${unitScale(s.unit)}em`}>
          <p class="st-row-n display">
            {s.prefix && <span class="st-row-pre">{s.prefix}</span>}
            {i === hero && plain(s.number) ? <CountUp to={Number(s.number)} decimals={s.number.includes('.') ? s.number.split('.')[1]!.length : 0} /> : <span>{s.number}</span>}
            {s.unit && <span class:list={['st-row-unit', { 'is-word': [...s.unit].length > 1 }]}>{s.unit}</span>}
          </p>
          <p class="st-row-l">{s.label}</p>
        </li>
      ))}
    </ul>
  </div>
</Slide>

<style>
  .st-row {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-rows: auto 1fr;
  }

  .st-row-head {
    max-width: 1500px;
    font-size: calc(var(--head) * var(--display-scale));
    line-height: min(var(--display-line), 1);
  }

  .st-row-head .hl { white-space: nowrap; }

  /* One row, one baseline: figures on the first track, labels on the second. */
  .st-row-stats {
    align-self: end;
    margin: 0;
    display: grid;
    grid-template-columns: var(--cols);
    grid-template-rows: auto auto;
    column-gap: var(--gap-x);
    border-top: 1px solid color-mix(in oklab, currentColor 24%, transparent);
    padding-top: calc(var(--gap) * 0.7);
  }

  .st-row-stat {
    grid-row: span 2;
    display: grid;
    grid-template-rows: subgrid;
    min-width: 0;
  }

  .st-row-n {
    grid-row: 1;
    align-self: end;
    margin: 0;
    display: flex;
    align-items: baseline;
    font-size: calc(var(--rest) * var(--display-scale));
    line-height: 0.82;
    letter-spacing: -0.04em;
    font-variant-numeric: lining-nums tabular-nums;
    white-space: nowrap;
    margin-left: -0.02em;
  }

  /* The focal element: the hero figure, at poster size, in the accent. */
  .is-hero .st-row-n {
    font-size: calc(var(--hero) * var(--display-scale));
    color: var(--hl-color);
  }

  :global(.tone-accent) .is-hero .st-row-n { color: var(--on-accent); }

  .st-row-pre {
    align-self: flex-start;
    font-size: 0.5em;
    margin: 0.04em 0.04em 0 0;
  }

  .st-row-unit { font-size: var(--unit); margin-left: 0.02em; }
  .st-row-unit.is-word { margin-left: 0.12em; letter-spacing: -0.02em; }

  .st-row-l {
    grid-row: 2;
    margin-top: calc(var(--gap) * 0.45);
    max-width: 22ch;
    font-size: var(--t-body);
    line-height: 1.3;
    color: color-mix(in oklab, currentColor 72%, transparent);
  }

  .is-hero .st-row-l {
    font-weight: 700;
    color: inherit;
  }

  :global(.tone-ink) .st-row-head { letter-spacing: calc(var(--display-tracking) * 0.85); }

  /* Phone: the hero across the width, the others as a quiet ledger under it. */
  @media (max-width: 799px) {
    .st-row {
      grid-template-rows: auto auto;
      align-content: start;
      row-gap: calc(var(--gap) * 1.5);
    }

    .st-row-head {
      max-width: none;
      font-size: calc(var(--head-phone) * var(--display-scale));
    }

    .st-row-stats {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      padding-top: 0;
      border-top: 0;
    }

    .st-row-stat {
      grid-row: auto;
      grid-template-rows: none;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 16px;
      padding: 12px 0;
      border-top: 1px solid color-mix(in oklab, currentColor 22%, transparent);
    }

    .st-row-stat .st-row-l { margin: 0; max-width: none; font-size: 15px; text-align: right; }
    .st-row-n { font-size: calc(28px * var(--display-scale)); }
    .st-row-unit.is-word { font-size: max(var(--unit), 13px); }

    .st-row-stat.is-hero {
      display: grid;
      gap: 10px;
      padding: 0 0 18px;
      border-top: 0;
    }

    .is-hero .st-row-n { font-size: calc(var(--hero-phone) * var(--display-scale)); }
  }

  /* PDF and every static render: CountUp prints the final figure; every stat in place. */
  :global(html.is-static) .st-row .rise {
    opacity: 1;
    transform: none;
  }
</style>
