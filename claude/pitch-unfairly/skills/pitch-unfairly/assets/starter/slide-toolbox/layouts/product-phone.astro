---
/**
 * product-phone: the product working on a phone, held up at full height.
 *
 * The headline sits low in a wide left column with one line of proof under
 * it. The right of the slide is a quiet field, run to the slide's edges, and
 * the phone stands in it at nearly the stage's full height with the brand's
 * focal shadow. The phone's frame is a plain bezel around a real screenshot:
 * the screen is the focal element, not the device.
 */
import Slide from '../../src/components/Slide.astro';
import { fitType, splitHl, type SlideBase } from '../lib';

interface Props extends SlideBase {
  /** What the screen proves, as a whole sentence. 12 words or fewer. */
  headline: string;
  /** One phrase of the headline, word for word, in the accent. */
  hl?: string;
  /** One line of proof the screen doesn't show: a number, a customer, a date. 90 characters or fewer. */
  caption?: string;
  /** The phone screenshot, portrait, about 9:19.5 (a 390x844 capture). */
  src: string;
  /** What the screenshot shows, for assistive tech. */
  alt: string;
  /** A sticker beside the phone. Use it to label an invented screen: "Example screen". */
  tag?: string;
}

const { id, label = 'Product on a phone', tone = 'paper', notes, brand, headline, hl, caption, src, alt, tag } = Astro.props;
const where = `product-phone "${id}"`;
if (headline.split(/\s+/).length > 14) throw new Error(`${where}: the headline is ${headline.split(/\s+/).length} words; the screen carries the detail. Cut it to 12 or fewer.`);
if (caption && caption.length > 90) throw new Error(`${where}: the caption is ${caption.length} characters; one line of 90 or fewer. Move the rest to the notes.`);
if (tag && tag.length > 24) throw new Error(`${where}: the tag is ${tag.length} characters; a sticker is two or three words.`);
const [before, phrase, after] = splitHl(headline, hl, where);
const head = fitType(headline.length, { width: 860, lines: 3, min: 84, max: 136 });
const phone = fitType(headline.length, { width: 330, lines: 3, min: 26, max: 40 });
---

<Slide id={id} label={label} tone={tone} notes={notes} brand={brand}>
  <div class="st-phone" style={`--head: ${head}px; --head-phone: ${phone}px`}>
    <div class="st-phone-copy">
      <h2 data-fit="3 3" class="display st-phone-head rise">
        <slot name="headline">{before}{phrase && <span class="hl">{phrase}</span>}{after}</slot>
      </h2>
      {caption && <p class="st-phone-cap rise" style="--d: 420ms">{caption}</p>}
    </div>
    <div class="st-phone-field">
      <figure class="st-phone-device rise" style="--d: 140ms">
        <img src={src} alt={alt} />
      </figure>
      {tag && <span class="st-phone-tag pop" style="--d: 600ms; --r: -4deg">{tag}</span>}
    </div>
  </div>
</Slide>

<style>
  .st-phone {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 720px;
    column-gap: calc(var(--gap) * 1.5);
  }

  .st-phone-copy {
    align-self: end;
    display: grid;
    gap: calc(var(--gap) * 0.7);
    padding-bottom: calc(var(--gap) * 0.6);
  }

  .st-phone-head {
    max-width: 880px;
    font-size: calc(var(--head) * var(--display-scale));
  }

  .st-phone-cap {
    max-width: 34ch;
    font-size: var(--t-lede);
    line-height: 1.3;
    color: color-mix(in oklab, currentColor 74%, transparent);
    text-wrap: pretty;
  }

  /* A quiet field to the slide's edges: the phone stands in it, not on the page. */
  .st-phone-field {
    position: relative;
    display: grid;
    place-items: center;
    margin: calc(var(--pad-y) * -1) calc(var(--pad-x) * -1) calc(var(--pad-y) * -1) 0;
    background: color-mix(in oklab, currentColor 6%, transparent);
  }

  /* The focal element: the screen at nearly the stage's height, in a plain bezel. */
  .st-phone-device {
    width: 432px;
    padding: 14px;
    border-radius: 68px;
    background: var(--ink);
    box-shadow: var(--shadow-focal);
  }

  .st-phone-device img {
    width: 100%;
    height: auto;
    aspect-ratio: 390 / 844;
    object-fit: cover;
    object-position: top;
    border-radius: 54px;
  }

  .st-phone-tag {
    position: absolute;
    top: 44px;
    right: 40px;
    padding: 10px 20px;
    border: var(--border-w) solid var(--border-color);
    border-radius: 999px;
    /* The kit's contrast-safe fill: small text on the accent itself can fall under 4.5:1 (MMA's pink). */
    background: var(--accent-fill, var(--accent));
    color: var(--on-accent-fill, var(--on-accent));
    font-family: var(--font-mono);
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: var(--label-case, uppercase);
    transform: rotate(calc(-4deg * var(--tilt)));
  }

  :global(.tone-ink) .st-phone-device { background: color-mix(in oklab, var(--on-night) 14%, var(--night)); }

  /* Phone: the headline on top, then the device, sized to the space left so
     the whole screen stays visible. The field becomes a band behind it. */
  @media (max-width: 799px) {
    .st-phone {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr);
      row-gap: calc(var(--gap) * 1.2);
    }

    .st-phone-copy { align-self: start; gap: 10px; padding: 0; }
    .st-phone-head { max-width: none; font-size: calc(var(--head-phone) * var(--display-scale)); }
    .st-phone-cap { max-width: none; font-size: var(--t-body); }

    .st-phone-field {
      min-height: 0;
      margin: 0 calc(var(--pad-x) * -1) calc(var(--pad-y) * -1);
      padding: 22px 0;
    }

    .st-phone-device {
      width: auto;
      height: 100%;
      max-height: 470px;
      aspect-ratio: 418 / 872;
      padding: 7px;
      border-radius: 34px;
    }

    .st-phone-device img { height: 100%; width: auto; border-radius: 27px; }
    .st-phone-tag { top: 10px; right: 14px; padding: 4px 10px; }
  }

  /* PDF and every static render: the screenshot prints as it sits, the sticker at its lean. */
  :global(html.is-static) .st-phone .rise {
    opacity: 1;
    transform: none;
  }
</style>
