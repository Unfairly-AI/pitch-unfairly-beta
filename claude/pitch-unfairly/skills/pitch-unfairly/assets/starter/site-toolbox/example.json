{
  "$comment": "The toolbox's worked example: a made-up scheduling vendor's proposal to a made-up client. Every component's tokens refer to this model. npm run site:new copies it to site/site.json; change the inputs, formulas and facts to yours, and rename tokens in the sections to match.",
  "engine": "sites@1.4",
  "title": "Northline scheduling for Harlow Services (sample)",
  "description": "A sample proposal: route planning and scheduling for Harlow Services's field technicians.",
  "sample": true,
  "model": {
    "inputs": {
      "techs": 40,
      "jobs": 5,
      "minutes": 8,
      "hourly": 48,
      "days": 230,
      "adoption": 0.8,
      "prices": [
        79,
        119,
        169
      ],
      "plan_i": 1,
      "rec_i": 1
    },
    "formulas": {
      "price": "prices[plan_i]",
      "fee": "techs * price * 12",
      "fee_mo": "techs * price",
      "hours": "techs * adoption * jobs * minutes / 60 * days",
      "value": "hours * hourly",
      "net": "value - fee",
      "ret": "value / fee",
      "payback": "round(fee / value * 12 * 10) / 10",
      "hours_tech_week": "round(jobs * minutes / 60 * 5)",
      "lost": "techs * jobs * minutes / 60 * days * hourly",
      "fee_rec": "techs * prices[rec_i] * 12",
      "value_half": "value * 0.5 / adoption",
      "net_half": "value_half - fee",
      "fee_0": "techs * prices[0] * 12",
      "fee_1": "techs * prices[1] * 12",
      "fee_2": "techs * prices[2] * 12",
      "ret_rec": "value / fee_rec"
    },
    "formats": {
      "hourly": "money",
      "price": "money",
      "fee": "money",
      "value": "money",
      "net": "money",
      "ret": "mult",
      "payback": "number",
      "hours": "int",
      "hours_tech_week": "int",
      "lost": "money",
      "fee_rec": "money",
      "value_half": "money",
      "net_half": "money",
      "adoption": "pct",
      "fee_0": "money",
      "fee_1": "money",
      "fee_2": "money",
      "techs": "int",
      "minutes": "int",
      "jobs": "int",
      "ret_rec": "mult",
      "fee_mo": "money"
    }
  },
