---
// The brand board: one 1920x1080 page that shows the kit at a glance, for the
// user to confirm before any deck is composed. Not part of the published deck.
// A kit filled from a full brand guide (lockups, color tiers, gradients, type
// roles, textures, graphic elements, messaging) gets a second sheet for those;
// a kit without them shows the first sheet only.
import '../brand/fonts';
import '../brand/brand.css';
import '../styles/deck.css';
import kit from '../../brand/brand.json';
import { brandName, elements, gradients, imagery, lockups, logos, messaging, textures, typeRoles } from '../brand/assets';
import { colorCss } from '../../bin/brand-lib.mjs';

const roles = [
  ['paper', '--paper'], ['surface', '--surface'], ['ink', '--ink'], ['ink_muted', '--ink-muted'],
  ['accent', '--accent'], ['accent_dark', '--accent-dark'], ['accent_secondary', '--accent-2'],
  ['on_accent', '--on-accent'], ['highlight', '--highlight'], ['positive', '--positive'],
] as const;
const palette = kit.palette as Record<string, unknown>;
const type = kit.typography as Record<string, { family: string; license?: string; stand_in_for?: string | null; weight?: number }>;
const style = kit.style as Record<string, unknown>;
type Extra = { name: string; hex: string; group?: string; use?: string };
type Application = { name: string; colors?: string[]; notes?: string };
type Role = { font?: string; use?: string };
const extras = (palette.extras ?? []) as Extra[];
const extraGroups = [...new Set(extras.filter((e) => e.group || e.use).map((e) => e.group ?? 'other'))];
const tiered = extraGroups.length > 0;
const applications = (palette.applications ?? []) as Application[];
const roleSpecs = ((kit.typography as Record<string, unknown>).roles ?? {}) as Record<string, Role>;
const gradientSpecs = (palette.gradients ?? []) as { name: string; use?: string }[];
const paint = (ref: string) => colorCss(ref, palette) ?? 'transparent';
const hasMessaging = Boolean(messaging.essence || messaging.taglines.length || messaging.key_messages.length || messaging.attributes.length);
const rich = lockups.length > 0 || tiered || gradients.length > 0 || applications.length > 0 || typeRoles.length > 0 || textures.length > 0 || elements.length > 0 || hasMessaging;
const sample = (kind: string) => ({
  frame: 'A framed block',
  bracket: 'A sentence held between the brackets.',
  'bar-under': 'Underlined',
  'knockout-word': 'Grain',
}[kind] ?? 'Sample');
const typeNote = (role: string) => {
  const t = type[role];
  if (!t) return '';
  return t.license === 'stand-in' ? `${t.family} · stand-in for ${t.stand_in_for ?? 'the brand face'}` : `${t.family} · ${t.license ?? ''}`;
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{brandName}: brand board</title>
  </head>
  <body>
    <main class="slide board">
      <header>
        <div class="identity">
          {logos.primary ? <img class="logo" src={logos.primary} alt={`${brandName} logo`} /> : <span class="wordmark display">{kit.identity.wordmark}</span>}
          <p class="eyebrow">Brand board · {kit.identity.domain ?? 'no domain'}</p>
        </div>
        <p class="fine">Confirm before composing. Every slide reads these tokens.</p>
      </header>

      <section class="type">
        <p class="display specimen">The quick headline<br /><span class="hl">lands here.</span></p>
        <p class="lede">Body copy sits in the brand's text face, at the deck's reading size, with its own spacing.</p>
        <ul class="type-notes fine">
          <li>Display: {typeNote('display')}</li>
          <li>Body: {typeNote('body')}</li>
          <li>Mono: {typeNote('mono')}</li>
        </ul>
      </section>

      <section class="swatches">
        {roles.filter(([key]) => palette[key] || ['surface', 'ink_muted', 'accent_dark', 'on_accent'].includes(key)).map(([key, token]) => (
          <figure>
            <i style={`background: var(${token})`}></i>
            <figcaption><b>{key}</b><span>{(palette[key] as string) ?? 'derived'}</span></figcaption>
          </figure>
        ))}
      </section>

      <section class="components">
        <span class="button">Primary action</span>
        <div class="card sample">
          <p class="eyebrow">Card</p>
          <p class="h">Radius {String(style.radius)}px · border {String(style.border_width)}px · {String(style.shadow)} shadow</p>
          <p>Motion: {String(style.motion)} · density: {String(style.density)} · tilt: {String(style.tilt)}</p>
        </div>
        <div class="card focal">
          <p class="eyebrow">Focal</p>
          <p class="h display">42%</p>
        </div>
      </section>

      <section class="imagery">
        {imagery.slice(0, 4).map((img) => <img src={img.url} alt={img.alt} />)}
        {!imagery.length && <p class="fine">No imagery in the kit yet.</p>}
        <p class="fine notes">{String(style.illustration_style ?? 'Illustration style: not set')}</p>
      </section>
    </main>

    {rich && (
      <main class="slide board more">
        <header>
          <p class="eyebrow">Brand board · from the guide</p>
          <p class="fine">Each section shows only what the kit defines.</p>
        </header>

        {lockups.length > 0 && (
          <section class="lockups">
            <h2 class="eyebrow">Logo lockups</h2>
            <div class="row">
              {lockups.map((l) => (
                <figure class:list={['lockup', l.background]}>
                  <img src={l.url} alt={`${brandName} ${l.name}`} />
                  <figcaption><b>{l.name}</b><span>{l.use || `on ${l.background}`}</span></figcaption>
                </figure>
              ))}
            </div>
          </section>
        )}

        {tiered && (
          <section class="tiers">
            <h2 class="eyebrow">Color tiers</h2>
            {extraGroups.map((group) => (
              <div class="tier">
                <p class="fine">{group}</p>
                <div class="row">
                  {extras.filter((e) => (e.group ?? 'other') === group).map((e) => (
                    <figure class="swatch">
                      <i style={`background: var(--c-${e.name})`}></i>
                      <figcaption><b>{e.name}</b><span>{e.hex}</span>{e.use && <span>{e.use}</span>}</figcaption>
                    </figure>
                  ))}
                </div>
              </div>
            ))}
          </section>
        )}

        {gradients.length > 0 && (
          <section class="gradients">
            <h2 class="eyebrow">Gradients</h2>
            <div class="row">
              {gradientSpecs.map((g) => (
                <figure class="swatch wide">
                  <i style={`background: var(--g-${g.name})`}></i>
                  <figcaption><b>{g.name}</b>{g.use && <span>{g.use}</span>}</figcaption>
                </figure>
              ))}
            </div>
          </section>
        )}

        {applications.length > 0 && (
          <section class="applications">
            <h2 class="eyebrow">Color by context</h2>
            {applications.map((a) => (
              <div class="application">
                <div class="set">{(a.colors ?? []).map((c) => <i style={`background: ${paint(c)}`} title={c}></i>)}</div>
                <p><b>{a.name}</b>{a.notes && <span class="fine-note"> {a.notes}</span>}</p>
              </div>
            ))}
          </section>
        )}

        {typeRoles.length > 0 && (
          <section class="roles">
            <h2 class="eyebrow">Type roles</h2>
            {typeRoles.map((role) => (
              <div class="role">
                <p class={`type-${role} specimen-line`}>The brand speaks in this voice.</p>
                <p class="fine-note"><b>{role}</b> · {roleSpecs[role]?.font ?? 'body'}{roleSpecs[role]?.use ? ` · ${roleSpecs[role].use}` : ''}</p>
              </div>
            ))}
          </section>
        )}

        {textures.length > 0 && (
          <section class="textures">
            <h2 class="eyebrow">Textures</h2>
            <div class="row">
              {textures.map((t) => (
                <figure class="tile">
                  <i style={`background: ${t.tint ?? 'var(--surface)'} url("${t.url}") center / cover; background-blend-mode: ${t.blend};`}></i>
                  <figcaption><b>{t.name}</b><span>{t.kind}{t.use ? ` · ${t.use}` : ''}</span></figcaption>
                </figure>
              ))}
            </div>
          </section>
        )}

        {elements.length > 0 && (
          <section class="elements">
            <h2 class="eyebrow">Graphic elements</h2>
            <div class="row">
              {elements.map((el) => (
                <figure class="element">
                  <div class="stage">
                    {el.className && el.kind === 'frame' && <div class={`${el.className} framed`}>{sample(el.kind)}</div>}
                    {el.className && el.kind === 'bracket' && <p class={el.className}>{sample(el.kind)}</p>}
                    {el.className && el.kind === 'bar-under' && <p class="display word"><span class={el.className}>{sample(el.kind)}</span></p>}
                    {el.className && el.kind === 'rule' && <hr class={el.className} />}
                    {el.className && el.kind === 'knockout-word' && <p class={`knockout ${el.className}`}>{sample(el.kind)}</p>}
                    {!el.className && el.example && <img src={el.example} alt={`${el.name} in the brand guide`} />}
                    {!el.className && !el.example && <p class="fine-note">Described in words only.</p>}
                  </div>
                  <figcaption><b>{el.name}</b><span>{el.kind}{el.use ? ` · ${el.use}` : ''}</span></figcaption>
                </figure>
              ))}
            </div>
          </section>
        )}

        {hasMessaging && (
          <section class="messaging">
            <h2 class="eyebrow">Messaging</h2>
            {messaging.essence && <p class="display essence">{messaging.essence}</p>}
            {messaging.taglines.length > 0 && <ul class="taglines">{messaging.taglines.map((t) => <li>{t}</li>)}</ul>}
            {messaging.key_messages.map((k) => (
              <div class="key">
                <p class="fine">{k.area}</p>
                <p class="h">{k.headline}</p>
                {k.body && <p class="fine-note">{k.body}</p>}
              </div>
            ))}
            {messaging.attributes.length > 0 && <p class="fine-note">{messaging.attributes.join(', ')}</p>}
          </section>
        )}
      </main>
    )}

    <style>
      body { background: var(--letterbox); }
      .board {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: auto auto 1fr auto;
        grid-template-areas: 'head head' 'type swatches' 'type components' 'imagery imagery';
        gap: 40px 80px;
        margin: 0 auto;
      }
      .type { grid-area: type; }
      .swatches { grid-area: swatches; }
      .components { grid-area: components; }
      .imagery { grid-area: imagery; }
      header { grid-area: head; display: flex; justify-content: space-between; align-items: flex-start; }
      .identity { display: flex; align-items: center; gap: 32px; }
      .logo { height: 72px; width: auto; max-width: 420px; object-fit: contain; }
      .wordmark { font-size: 64px; }
      .eyebrow { color: var(--accent-dark); }
      .specimen { font-size: var(--t-title); margin-bottom: 28px; }
      .lede { color: var(--ink-muted); max-width: 26ch; margin-bottom: 24px; }
      .type-notes { display: grid; gap: 6px; }
      .swatches { display: grid; grid-template-columns: repeat(5, 1fr); gap: 18px; align-content: start; }
      .swatches i { display: block; aspect-ratio: 1.3; border-radius: calc(var(--radius) * 0.5); border: 1px solid var(--tint-3); }
      .swatches figcaption { display: grid; gap: 2px; padding-top: 8px; font: 500 15px/1.3 var(--font-mono); }
      .swatches figcaption span { color: var(--ink-faint); }
      .components { display: flex; gap: 28px; align-items: center; align-self: start; }
      .button {
        padding: 22px 36px; border-radius: var(--radius-button); background: var(--accent); color: var(--on-accent);
        white-space: nowrap; font: 600 24px/1 var(--font-body); box-shadow: var(--shadow-card); border: var(--border-w) solid var(--border-color);
      }
      .sample { padding: 24px 28px; max-width: 380px; display: grid; gap: 8px; }
      .sample .h { font: 600 22px/1.25 var(--font-body); }
      .sample p:last-child { font-size: 18px; color: var(--ink-muted); }
      .focal { padding: 20px 32px; box-shadow: var(--shadow-focal); }
      .focal .h { font-size: 80px; color: var(--accent); }
      .imagery { display: flex; gap: 16px; align-items: flex-end; flex-wrap: wrap; }
      .imagery img { height: 170px; width: auto; max-width: 260px; object-fit: cover; border-radius: calc(var(--radius) * 0.5); }
      .notes { flex-basis: 100%; text-transform: none; letter-spacing: 0; }

      /* The second sheet grows with the guide instead of clipping it. */
      .more {
        display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: none; grid-auto-rows: min-content; grid-template-areas: none;
        gap: 48px 64px; height: auto; min-height: 1080px; overflow: visible; margin-top: 40px;
      }
      .more header { grid-area: auto; grid-column: 1 / -1; }
      .more section { display: grid; gap: 16px; align-content: start; }
      .more .lockups, .more .elements, .more .messaging { grid-column: 1 / -1; }
      .more h2.eyebrow { margin: 0; }
      .more .row { display: flex; flex-wrap: wrap; gap: 20px; }
      .more figure { margin: 0; display: grid; gap: 8px; align-content: start; }
      .more figcaption { display: grid; gap: 2px; font: 500 15px/1.35 var(--font-mono); max-width: 34ch; }
      .more figcaption span, .fine-note { color: var(--ink-muted); font-size: 16px; line-height: 1.4; }
      .lockup { padding: 20px; border-radius: calc(var(--radius) * 0.5); border: 1px solid var(--tint-3); background: var(--paper); }
      .lockup.dark { background: var(--night); color: var(--on-night); }
      .lockup.dark figcaption span { color: color-mix(in oklab, var(--on-night) 70%, var(--night)); }
      .lockup img { height: 72px; width: auto; max-width: 340px; object-fit: contain; }
      .swatch i, .tile i { display: block; width: 120px; aspect-ratio: 1.3; border-radius: calc(var(--radius) * 0.4); border: 1px solid var(--tint-3); }
      .swatch.wide i { width: 240px; }
      .tile i { width: 180px; }
      .tier { display: grid; gap: 8px; }
      .application { display: grid; gap: 6px; }
      .application .set { display: flex; }
      .application .set i { width: 56px; height: 40px; border: 1px solid var(--tint-3); }
      .application .set i:first-child { border-radius: 8px 0 0 8px; }
      .application .set i:last-child { border-radius: 0 8px 8px 0; }
      .application p { font-size: 18px; }
      .role { display: grid; gap: 4px; }
      .specimen-line { font-size: 30px; }
      .element { width: 380px; }
      .element .stage { min-height: 150px; display: grid; place-items: center; padding: 16px; background: var(--surface); border-radius: calc(var(--radius) * 0.5); }
      .element .stage img { max-height: 150px; max-width: 100%; object-fit: contain; }
      .framed { padding: 24px 32px; font-size: 20px; }
      .element .word { font-size: 56px; }
      .element hr { width: 100%; }
      .knockout { font: var(--display-weight) 96px/1 var(--font-display); letter-spacing: var(--display-tracking); }
      .essence { font-size: 48px; max-width: 30ch; }
      .taglines { display: flex; flex-wrap: wrap; gap: 12px 32px; font-size: 22px; padding: 0; list-style: none; }
      .key { display: grid; gap: 4px; max-width: 70ch; }
      .key .h { font: 600 24px/1.25 var(--font-body); }
    </style>
  </body>
</html>
