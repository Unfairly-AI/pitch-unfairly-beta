---
// Pattern: close. A dark slide, the request at hero size, and one button-like
// element. One ask, no filler line.
import Slide from '../components/Slide.astro';
import BrandMark from '../components/BrandMark.astro';
---

<Slide
  id="ask"
  label="Your turn"
  tone="ink"
  bare
  notes="Close with one request the audience can say yes to today. Here it's to start with the story: write what each slide must prove, then make it beautiful."
>
  <div class="ask">
    <BrandMark on="ink" height={44} class="rise mark" />
    <h2 class="display hero rise" style="--d: 80ms">Now it's your turn to <span class="hl">pitch unfairly.</span></h2>
    <span class="cta pop" style="--d: 320ms">Start with your story <span aria-hidden="true">→</span></span>
  </div>
</Slide>

<style>
  .ask { flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; }
  .mark { margin-bottom: 72px; }
  .hero { max-width: 12ch; margin-bottom: 52px; }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    padding: 34px 56px;
    border: var(--border-w) solid var(--on-night);
    border-radius: var(--radius-button);
    background: var(--accent);
    /* On a dark slide the accent is its lighter night tint, so the label is night-dark to read on it. */
    color: var(--night);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--on-night);
    font: 800 50px/1 var(--font-display);
    letter-spacing: -0.02em;
  }

  @media (max-width: 799px) {
    .mark { margin-bottom: 26px; }
    .hero { margin-bottom: 24px; }
    .cta { padding: 18px 26px; box-shadow: 4px 4px 0 var(--on-night); font-size: 21px; }
  }
</style>
