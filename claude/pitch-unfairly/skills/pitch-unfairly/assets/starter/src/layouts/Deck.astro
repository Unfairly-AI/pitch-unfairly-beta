---
// Fonts and tokens come from the brand kit (brand/brand.json via npm run brand:apply).
import '../brand/fonts';
import '../brand/brand.css';
import '../styles/deck.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Before first paint: ?pdf=1 renders every slide 1:1 for the PDF and the
      // audits; inside a host frame (pitchunfairly.com) the deck reports its
      // slide and asks the frame for fullscreen.
      if (/[?&]pdf=1(&|$)/.test(location.search)) document.documentElement.classList.add('is-pdf', 'is-static');
      if (window.parent !== window) document.documentElement.classList.add('is-framed');
      // Hide slides that haven't played yet, so content doesn't show and then
      // re-enter. Static renders and reduced motion skip this.
      if (!/[?&]pdf=1(&|$)/.test(location.search) && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('is-armed');
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <main class="stage" id="stage">
      <slot />
    </main>

    <nav class="deck-nav" aria-label="Deck controls">
      <button type="button" data-go="prev" aria-label="Previous slide">‹</button>
      <span class="deck-count" aria-live="polite"><b id="deck-current">1</b> / <span id="deck-total">1</span></span>
      <button type="button" data-go="next" aria-label="Next slide">›</button>
      <button type="button" data-go="notes" class="deck-text-btn" aria-pressed="false">Notes</button>
      <a class="deck-text-btn" href="deck.pdf" download>PDF</a>
    </nav>
    <aside class="deck-notes" id="deck-notes" hidden></aside>

    <script>
      /*
        The deck scrolls like a website: every slide fills one screen and the
        page snaps between them, so a mouse wheel, trackpad, or swipe moves a
        slide at a time. It also behaves like a deck: arrow keys, Space, Page
        Up/Down, Home/End, N for notes, F for fullscreen. Each slide's entrance
        plays the first time it comes into view.
      */
      const html = document.documentElement;
      const frames = [...document.querySelectorAll<HTMLElement>('.stage > .deck-frame')];
      const slides = frames.map((f) => f.querySelector<HTMLElement>('.slide')!);
      const pdf = html.classList.contains('is-pdf');
      const framed = html.classList.contains('is-framed');
      // Tell a host frame (pitchunfairly.com) where we are. Its badge and
      // fullscreen live outside this sandboxed document.
      const toFrame = (message: Record<string, unknown>) => {
        if (framed) window.parent.postMessage(message, '*');
      };
      const notesEl = document.getElementById('deck-notes');
      const notesBtn = document.querySelector<HTMLButtonElement>('[data-go="notes"]');
      const played = new Set<number>();
      let current = -1;

      // Effects driven by JS (counters, typing) should check this and render
      // their finished state instead of animating.
      (window as any).deckStill = () => pdf || matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Stage scale: the 1920x1080 slide fits its frame (one screen).
      const fit = () => {
        const frame = frames[0];
        if (!frame) return;
        html.style.setProperty('--s', String(Math.min(frame.clientWidth / 1920, frame.clientHeight / 1080)));
      };

      const setCurrent = (index: number) => {
        if (index === current) return;
        current = index;
        slides.forEach((slide, i) => slide.classList.toggle('is-active', i === index));
        const slide = slides[index];
        if (!played.has(index)) {
          played.add(index);
          // Script-driven motion (CountUp) listens for this.
          slide.dispatchEvent(new CustomEvent('deck:enter'));
        } else {
          // Coming back: show the finished slide instead of replaying.
          slide.classList.add('is-replay');
        }
        history.replaceState(null, '', `#${index + 1}`);
        const count = document.getElementById('deck-current');
        if (count) count.textContent = String(index + 1);
        if (notesEl) notesEl.textContent = slide.dataset.notes || 'No notes for this slide.';
        toFrame({ type: 'deck:slide', index, total: slides.length });
      };

      const go = (index: number, smooth = true) => {
        const i = Math.max(0, Math.min(frames.length - 1, index));
        // Scroll only this document: scrollIntoView would also scroll a page that embeds the deck.
        document.scrollingElement?.scrollTo({ top: frames[i].offsetTop, behavior: smooth ? 'smooth' : 'auto' });
        setCurrent(i);
      };

      // Jump to a slide and play its entrance from the start, even on a
      // revisit. npm run motion uses this to film every entrance.
      (window as any).deckReplay = (index: number) => {
        played.clear();
        slides.forEach((slide) => slide.classList.remove('is-replay', 'is-active'));
        current = -1;
        go(index, false);
      };

      const fromHash = () => {
        const n = parseInt(location.hash.slice(1), 10);
        return Number.isFinite(n) ? n - 1 : 0;
      };

      if (!pdf) {
        const total = document.getElementById('deck-total');
        if (total) total.textContent = String(slides.length);
        history.scrollRestoration = 'manual';
        fit();
        addEventListener('resize', fit);
        go(fromHash(), false);
        addEventListener('hashchange', () => {
          if (fromHash() !== current) go(fromHash());
        });

        // Whichever slide holds most of the screen is the current one.
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) setCurrent(frames.indexOf(entry.target as HTMLElement));
          }
        }, { threshold: 0.55 });
        frames.forEach((frame) => observer.observe(frame));

        document.querySelectorAll<HTMLElement>('[data-go="prev"], [data-go="next"]').forEach((el) => {
          el.addEventListener('click', () => go(current + (el.dataset.go === 'prev' ? -1 : 1)));
        });

        const toggleNotes = () => {
          if (!notesEl || !notesBtn) return;
          notesEl.hidden = !notesEl.hidden;
          notesBtn.setAttribute('aria-pressed', String(!notesEl.hidden));
        };
        notesBtn?.addEventListener('click', toggleNotes);

        addEventListener('keydown', (event) => {
          const target = event.target as HTMLElement;
          if (event.metaKey || event.ctrlKey || event.altKey) return;
          if (target.closest('input, textarea, select, button, a, [contenteditable="true"]') && event.key === ' ') return;
          if (target.closest('input, textarea, select, [contenteditable="true"]')) return;
          const key = event.key;
          if (['ArrowRight', 'ArrowDown', 'PageDown', ' '].includes(key)) go(current + (event.shiftKey && key === ' ' ? -1 : 1));
          else if (['ArrowLeft', 'ArrowUp', 'PageUp'].includes(key)) go(current - 1);
          else if (key === 'Home') go(0);
          else if (key === 'End') go(slides.length - 1);
          else if (key === 'f') {
            if (framed) toFrame({ type: 'deck:fullscreen' });
            else if (document.fullscreenElement) document.exitFullscreen();
            else html.requestFullscreen?.();
          } else if (key === 'n') toggleNotes();
          else return;
          event.preventDefault();
        });

        // Horizontal swipe on tablets also steps through the deck.
        let touchX = 0;
        let touchY = 0;
        addEventListener('touchstart', (e) => {
          touchX = e.touches[0].clientX;
          touchY = e.touches[0].clientY;
        }, { passive: true });
        addEventListener('touchend', (e) => {
          const dx = e.changedTouches[0].clientX - touchX;
          const dy = e.changedTouches[0].clientY - touchY;
          if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) go(current + (dx < 0 ? 1 : -1));
        }, { passive: true });

        // Fullscreen and rotation resize the frames; keep the current slide in place.
        const settle = () => requestAnimationFrame(() => { fit(); go(current, false); });
        document.addEventListener('fullscreenchange', settle);
        matchMedia('(max-width: 799px)').addEventListener('change', settle);

        // Hide the controls while presenting with a still mouse.
        let idle: number | undefined;
        const wake = () => {
          html.classList.remove('is-idle');
          clearTimeout(idle);
          idle = window.setTimeout(() => html.classList.add('is-idle'), 2200);
        };
        addEventListener('mousemove', wake);
        wake();
      }

      addEventListener('beforeprint', () => html.classList.add('is-static'));
      addEventListener('afterprint', () => !pdf && html.classList.remove('is-static'));

      // The PDF exporter waits for fonts and every image before printing.
      Promise.all([
        document.fonts.ready,
        ...[...document.images].map((img) => (img.complete ? null : img.decode().catch(() => null))),
      ]).then(() => {
        (window as any).__deckReady = true;
      });
    </script>

    <style is:global>
      :root { --s: 0.5; }

      /* Screen: one slide per screen, stacked, snapping like a deck. */
      html:not(.is-pdf) { scroll-snap-type: y mandatory; }
      html:not(.is-pdf) body { background: var(--letterbox); }

      /* overflow-x: hidden on body would make it the scroll container and
         strand the snap points; clip trims sideways overflow without that. */
      html:not(.is-pdf),
      html:not(.is-pdf) body { overflow-x: clip; }

      .stage { counter-reset: slide; }

      /* Each frame is one full screen in its slide's color; the slide is
         scaled to fit inside it. */
      .deck-frame {
        position: relative;
        height: 100svh;
        overflow: hidden;
        scroll-snap-align: start;
        scroll-snap-stop: always;
      }

      .deck-frame > .slide {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%) scale(var(--s));
      }

      /* A slide that hasn't come into view yet waits, so its entrance plays clean. */
      html.is-armed .slide:not(.is-active):not(.is-replay) > * { opacity: 0; }
      /* A revisited slide shows its finished state instead of replaying. */
      .slide.is-replay *,
      .slide.is-replay *::before,
      .slide.is-replay *::after { animation: none !important; }

      /* PDF: every slide 1:1, one per page. */
      @page {
        size: 1920px 1080px;
        margin: 0;
      }

      html.is-pdf,
      html.is-pdf body {
        width: 1920px;
        overflow: visible;
        background: var(--paper);
      }

      html.is-pdf .deck-frame {
        height: auto;
        overflow: visible;
        break-after: page;
      }

      html.is-pdf .deck-frame:last-child {
        break-after: auto;
      }

      html.is-pdf .deck-frame > .slide {
        position: relative;
        left: auto;
        top: auto;
        transform: none;
      }

      html.is-pdf .deck-nav,
      html.is-pdf .deck-notes {
        display: none !important;
      }

      /* Phone: the slide itself is the screen, laid out at phone size. */
      @media (max-width: 799px) {
        html:not(.is-pdf) .deck-frame { height: auto; }

        html:not(.is-pdf) .deck-frame > .slide {
          position: relative;
          left: auto;
          top: auto;
          width: 100%;
          height: 100svh;
          transform: none;
        }
      }

      /* Controls */
      .deck-nav {
        position: fixed;
        right: 20px;
        bottom: 20px;
        z-index: 20;
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 6px;
        border: 2px solid var(--border-color);
        border-radius: 999px;
        background: var(--paper);
        box-shadow: 3px 3px 0 var(--ink);
        font: 600 13px/1 var(--font-mono);
        color: var(--ink);
        transition: opacity 0.3s var(--ease);
      }

      html.is-idle .deck-nav:not(:hover):not(:focus-within) {
        opacity: 0;
      }

      .deck-nav button,
      .deck-nav a {
        min-width: 32px;
        height: 32px;
        padding: 0 10px;
        border: 0;
        border-radius: 999px;
        background: transparent;
        color: inherit;
        font: inherit;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
      }

      .deck-nav button:hover,
      .deck-nav a:hover,
      .deck-nav [aria-pressed='true'] {
        background: var(--surface);
      }

      .deck-nav :focus-visible {
        outline: 2px solid var(--accent-2);
        outline-offset: 2px;
      }

      .deck-count {
        padding: 0 6px;
        font-variant-numeric: tabular-nums;
      }

      .deck-notes {
        position: fixed;
        left: 20px;
        bottom: 20px;
        z-index: 20;
        width: min(520px, calc(100vw - 40px));
        max-height: 40vh;
        overflow: auto;
        padding: 18px 20px;
        border: 2px solid var(--border-color);
        border-radius: 14px;
        background: var(--paper);
        color: var(--ink);
        box-shadow: 3px 3px 0 var(--ink);
        font: 15px/1.5 var(--font-body);
        white-space: pre-line;
      }

      /* Keep notes clear of the host frame's badge (bottom left). */
      html.is-framed .deck-notes {
        bottom: 64px;
      }

      /* On a phone the controls would sit on top of every slide (only the PDF
         link shows there), so they move into the page after the last slide. */
      @media (max-width: 799px) {
        .deck-nav {
          position: static;
          width: max-content;
          margin: 24px auto 32px;
          padding: 3px;
          box-shadow: none;
        }

        html.is-idle .deck-nav:not(:hover):not(:focus-within) {
          opacity: 1;
        }

        .deck-nav button,
        .deck-count {
          display: none;
        }
      }
    </style>
  </body>
</html>
