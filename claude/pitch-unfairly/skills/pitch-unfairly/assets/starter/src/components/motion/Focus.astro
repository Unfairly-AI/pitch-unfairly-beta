---
/**
 * Focus: a screenshot or photo that slowly closes in on one detail (Ken
 * Burns), then spotlights it with a ring and an optional callout. Its resting
 * state is the end of the move: the PDF, reduced motion and a revisit show the
 * detail in focus, so the still slide carries the same point.
 *
 *   <Focus src={shot} alt="Interview notes" ratio="16 / 10"
 *     detail={{ x: 58, y: 22, w: 30, h: 24 }} callout="Scorecard filled from the call" />
 *
 * detail is the region in percent of the image (left, top, width, height).
 * crop (same units) shows only part of the image in the frame, so the move
 * starts on a clean edge instead of a half-cut table: give it whenever the
 * whole screenshot carries more than the slide needs.
 * zoom defaults to what makes the detail about half the frame, 1x to 1.8x.
 */
interface Props {
  src: string;
  alt: string;
  /** The region to focus, in percent of the image: left, top, width, height. */
  detail: { x: number; y: number; w: number; h: number };
  /** The image's aspect ratio, as CSS ("16 / 10"). */
  ratio?: string;
  /** The part of the image the frame shows, in percent of the image: left, top, width, height. Default all of it. */
  crop?: { x: number; y: number; w: number; h: number };
  /** How far to close in, 1 to 2. Default: the detail about half the frame. */
  zoom?: number;
  /** One short line naming what the detail shows. 60 characters or fewer. */
  callout?: string;
  /** The veil over everything but the detail: "dark" (default) for light images, "light" for dark screens, where a dark veil wouldn't show. */
  veil?: 'dark' | 'light';
  /** A key shared with an element on the previous slide: this frame travels from there (data-carry). */
  carry?: string;
  class?: string;
}

const { src, alt, detail: full, crop = { x: 0, y: 0, w: 100, h: 100 }, ratio = '16 / 10', zoom, callout, veil = 'dark', carry, class: cls } = Astro.props;
const where = `Focus "${alt}"`;
const inside = (r: { x: number; y: number; w: number; h: number }, b = { x: 0, y: 0, w: 100, h: 100 }) => [r.x, r.y, r.w, r.h].every((n) => Number.isFinite(n)) && r.w > 0 && r.h > 0 && r.x >= b.x - 0.5 && r.y >= b.y - 0.5 && r.x + r.w <= b.x + b.w + 0.5 && r.y + r.h <= b.y + b.h + 0.5;
if (!inside(crop)) throw new Error(`${where}: crop is {x, y, w, h} in percent of the image and stays inside it (got ${JSON.stringify(crop)}).`);
if (!inside(full, crop)) throw new Error(`${where}: the detail ${JSON.stringify(full)} has to sit inside the crop ${JSON.stringify(crop)}.`);
const [rw, rh] = ratio.split('/').map((n) => Number(n.trim()));
if (!(rw > 0 && rh > 0)) throw new Error(`${where}: ratio is the image's width / height, like "16 / 10" (got "${ratio}").`);
// The frame is the crop: its ratio, and the detail in its own percentages.
const frameRatio = `${((rw * crop.w) / 100).toFixed(3)} / ${((rh * crop.h) / 100).toFixed(3)}`;
const detail = { x: ((full.x - crop.x) / crop.w) * 100, y: ((full.y - crop.y) / crop.h) * 100, w: (full.w / crop.w) * 100, h: (full.h / crop.h) * 100 };
const imgBox = `width: ${(10000 / crop.w).toFixed(3)}%; height: ${(10000 / crop.h).toFixed(3)}%; left: ${((-crop.x / crop.w) * 100).toFixed(3)}%; top: ${((-crop.y / crop.h) * 100).toFixed(3)}%`;
const { x, y, w, h } = detail;
if (![x, y, w, h].every((n) => Number.isFinite(n)) || x < 0 || y < 0 || w <= 0 || h <= 0 || x + w > 100.5 || y + h > 100.5) {
  throw new Error(`${where}: detail is {x, y, w, h} in percent of the image and stays inside it (got ${JSON.stringify(detail)}).`);
}
if (callout && callout.length > 60) throw new Error(`${where}: the callout is ${callout.length} characters; say it in 60 or fewer.`);
if (zoom !== undefined && !(zoom >= 1 && zoom <= 2)) throw new Error(`${where}: zoom is 1 to 2 (got ${zoom}); closer than 2x reads as a different image.`);

const z = zoom ?? Math.max(1, Math.min(1.8, 50 / w, 60 / h));
const ox = x + w / 2;
const oy = y + h / 2;
// Move the detail toward the middle, never so far the frame shows past the image.
const clamp = (t: number, o: number) => Math.max(-(100 - o) * (z - 1), Math.min(o * (z - 1), t));
const tx = clamp(50 - ox, ox);
const ty = clamp(50 - oy, oy);
// Where the detail lands at the end of the move, in percent of the frame.
const at = (p: number, o: number, t: number) => o + (p - o) * z + t;
const ring = { left: at(x, ox, tx), top: at(y, oy, ty), width: w * z, height: h * z };
// The callout sits under the ring, over it, or inside its top edge: always inside the frame.
const place = ring.top + ring.height < 74 ? 'below' : ring.top > 16 ? 'above' : 'inside';
const f = (n: number) => `${n.toFixed(2)}%`;
---

<figure
  class:list={['m-focus', `is-veil-${veil}`, cls]}
  data-m="focus"
  data-carry={carry}
  style={`--ratio: ${frameRatio}; --to: translate(${f(tx)}, ${f(ty)}) scale(${z.toFixed(3)}); --o: ${f(ox)} ${f(oy)}`}>
  <div class="m-focus-pan" data-bleed>
    <img src={src} alt={alt} loading="eager" decoding="async" style={imgBox} />
  </div>
  <span class="m-focus-ring" aria-hidden="true" style={`left: ${f(ring.left)}; top: ${f(ring.top)}; width: ${f(ring.width)}; height: ${f(ring.height)}`}></span>
  {callout && (
    <figcaption
      class:list={['m-focus-call', `is-${place}`]}
      style={`left: ${f(Math.min(Math.max(ring.left + (place === 'inside' ? 1.5 : 0), 3), 60))}; ${place === 'below' ? `top: calc(${f(ring.top + ring.height)} + 14px)` : place === 'above' ? `bottom: calc(${f(100 - ring.top)} + 14px)` : `top: calc(${f(Math.max(ring.top, 0))} + 14px)`}`}>
      {callout}
    </figcaption>
  )}
</figure>

<style>
  .m-focus {
    position: relative;
    margin: 0;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface);
  }

  .m-focus-pan {
    position: absolute;
    inset: 0;
    transform-origin: var(--o);
    transform: var(--to);
  }

  .m-focus-pan img {
    position: absolute;
    display: block;
    max-width: none;
    object-fit: fill;
  }

  /* The spotlight: a ring around the detail, the rest of the image dimmed. */
  .m-focus-ring {
    position: absolute;
    border: 3px solid var(--paper);
    border-radius: min(var(--radius), 14px);
    box-shadow: 0 0 0 200vmax color-mix(in oklab, var(--night) 42%, transparent);
  }

  .is-veil-light .m-focus-ring {
    border-color: var(--hl-color);
    box-shadow: 0 0 0 200vmax color-mix(in oklab, var(--paper) 62%, transparent);
  }

  .m-focus-call {
    position: absolute;
    max-width: 38%;
    padding: 0.5em 0.85em;
    border-radius: min(var(--radius-button), 24px);
    background: var(--paper);
    color: var(--ink);
    font: 600 var(--t-label) / 1.25 var(--font-body);
  }

  /* Live: the frame starts wide, closes in on the brand's move curve, then the
     spotlight and the callout land. */
  :global(.is-active) .m-focus-pan {
    animation: m-focus-pan var(--dur-pan) var(--ease-move, var(--ease)) calc(var(--d, 0ms) + var(--dur-small, 200ms)) both;
  }

  :global(.is-active) .m-focus-ring {
    animation: m-focus-ring var(--dur-medium, 300ms) var(--ease) calc(var(--d, 0ms) + var(--dur-pan) + var(--dur-small, 200ms)) both;
  }

  :global(.is-active) .m-focus-call {
    animation: rise var(--dur-enter) var(--ease) calc(var(--d, 0ms) + var(--dur-pan) + var(--dur-medium, 300ms)) both;
  }

  @keyframes m-focus-pan {
    from { transform: none; }
    to { transform: var(--to); }
  }

  @keyframes m-focus-ring {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (max-width: 799px) {
    .m-focus-call { max-width: 70%; font-size: 13px; }
    .m-focus-ring { border-width: 2px; }
  }

  :global(html.is-static) .m-focus-pan,
  :global(html.is-static) .m-focus-ring,
  :global(html.is-static) .m-focus-call {
    animation: none !important;
    opacity: 1;
  }

  :global(html.is-static) .m-focus-pan { transform: var(--to); }

  /* Reduced motion: no move at all; the detail is simply shown in focus. */
  @media (prefers-reduced-motion: reduce) {
    .m-focus-pan,
    .m-focus-ring,
    .m-focus-call { animation: none !important; }
  }
</style>
